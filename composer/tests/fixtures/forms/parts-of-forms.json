{
  "schema": "ursatz-form",
  "version": 2,
  "name": "parts-of-forms",
  "label": "Parts of forms",
  "modulates": true,
  "regions": [{"name": "subordinate", "major": ["omt.relation.dominant"], "minor": ["omt.relation.mediant"]}],
  "sizes": [
    {"bars": 48, "default": true, "sections": [
      {"name": "A", "letter": "A", "role": "theme", "bars": 8, "beginning": "presentation", "ending": "continuation", "cadence": "perfect-authentic", "closed": true},
      {"name": "T", "letter": "T", "role": "transition", "bars": 8, "beginning": "presentation", "ending": "continuation", "cadence": "half", "keys": {"end": "subordinate"}},
      {"name": "S", "letter": "S", "role": "subordinate", "bars": 8, "beginning": "antecedent", "ending": "consequent", "cadence": "perfect-authentic", "keys": {"start": "subordinate", "end": "subordinate"}, "lyric": true},
      {"name": "C", "letter": "C", "role": "codetta", "bars": 4, "beginning": "antecedent", "ending": "cadential", "cadence": "perfect-authentic", "keys": {"start": "subordinate", "end": "subordinate"}},
      {"name": "R", "letter": "R", "role": "retransition", "bars": 4, "cadence": "half"},
      {"name": "A return", "letter": "A", "role": "return", "bars": 8, "beginning": "presentation", "ending": "continuation", "cadence": "perfect-authentic", "closed": true, "returns": "A", "variation": "exact"},
      {"name": "K", "letter": "K", "role": "coda", "bars": 8, "cadence": "perfect-authentic"}
    ]}
  ]
}
