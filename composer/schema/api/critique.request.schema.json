{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz/composer/schema/api/critique.request.schema.json",
  "title": "composer_api_critique request",
  "description": "One to sixteen candidates, each a plan document or a motive document, judged together by the critic. The preferences' critic group sets the weights and the evaluators that count the other way.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "candidates"
  ],
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "integer"
    },
    "schema": {
      "const": "ursatz-critique-request"
    },
    "schema_version": {
      "const": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "plan"
            ],
            "additionalProperties": false,
            "properties": {
              "plan": {
                "type": "object",
                "description": "A plan document of a theme or a piece: its melody is judged, and a node named theme is also heard against its plan."
              }
            }
          },
          {
            "type": "object",
            "required": [
              "motive"
            ],
            "additionalProperties": false,
            "properties": {
              "motive": {
                "type": "object",
                "description": "A motive document, as the motive member of a listen sample."
              }
            }
          }
        ]
      }
    },
    "preferences": {
      "$ref": "https://github.com/Mitchell-Opitz/Ursatz/composer/schema/api/preferences.schema.json",
      "description": "The settings document; its critic group applies."
    }
  }
}
