{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz/composer/schema/api/preferences.schema.json",
  "title": "Composer preferences",
  "type": "object",
  "description": "The Composer's settings (docs/preferences.md); every member is optional and its default is the value the Composer used before the document existed. An unknown member is refused with its path.",
  "additionalProperties": false,
  "properties": {
    "melody": {
      "type": "object",
      "description": "The settings of the melody stage (docs/preferences.md).",
      "additionalProperties": false,
      "properties": {
        "range": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "low": {
              "type": "integer",
              "minimum": 36,
              "maximum": 96
            },
            "high": {
              "type": "integer",
              "minimum": 48,
              "maximum": 108,
              "description": "At least range.low + 12."
            }
          }
        },
        "nct_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "passing",
              "neighbor",
              "appoggiatura",
              "suspension",
              "anticipation"
            ]
          }
        },
        "density": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "climax_position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "climax_rise": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "climax_slack": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "second_nearest_chord_tone": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$",
          "description": "n/d with 0 <= n <= d and d from 1 to 16."
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "keep": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "At most attempts."
        },
        "plain_shaping": {
          "type": "boolean"
        },
        "weights": {
          "type": "object",
          "description": "The weight each group of soft rules counts in a melody's score.",
          "additionalProperties": false,
          "properties": {
            "melodic": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "against_bass": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "tendency": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "climax": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "contour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "ending_reduction": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "waves": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "central_range": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "monotony": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "seam": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "closure": {
          "type": "object",
          "description": "How many times the closure rules count for the theme's last cadence (final) and for an earlier one (first). 0 leaves them out.",
          "additionalProperties": false,
          "properties": {
            "final": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "first": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "rhythm_repeat_bars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "description": "The most bars in a row of 2 or more notes that may share one rhythm. 0 sets no limit."
        },
        "leaps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "How many times a melody's leaps count against it. 0 leaves them out."
        },
        "register": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "How many times an idea's drift from the register of the span before it counts against it. 0 leaves it out."
        },
        "cadence_long": {
          "type": "boolean",
          "description": "The idea that ends a cadence ends on one note held from its last downbeat to its end, on the cadence's tone (R-712). Off by default."
        },
        "waive": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "forbidden-leap",
              "forbidden-outline",
              "no-crossing",
              "parallel-octaves",
              "parallel-fifths",
              "dissonance-against-bass",
              "strong-beat-chord-tone"
            ]
          },
          "description": "The hard rules of the melody stage that are not held (R-672): a waived rule neither refuses a candidate nor scores it. Empty by default."
        },
        "reverse": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "melodic",
              "against_bass",
              "tendency",
              "climax",
              "contour",
              "ending_reduction",
              "waves",
              "central_range",
              "monotony",
              "seam",
              "closure",
              "leaps",
              "register"
            ]
          },
          "description": "The soft rule groups whose score counts what a candidate breaks in place of what it holds (R-672), so a setting can ask for the opposite. Empty by default."
        }
      }
    },
    "motif": {
      "type": "object",
      "description": "The settings of the segments motive generator (docs/preferences.md).",
      "additionalProperties": false,
      "properties": {
        "bars": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
          "additionalProperties": false,
          "properties": {
            "one": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "two": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "pickup_one_in": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "A pickup is drawn one time in this many; 0 never draws one."
        },
        "shapes_one_bar": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
          "additionalProperties": false,
          "properties": {
            "repeat": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "contrast": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "shapes_two_bars": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
          "additionalProperties": false,
          "properties": {
            "repeat": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "contrast": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "repeat_contrast": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "plans_two": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
          "additionalProperties": false,
          "properties": {
            "I-V": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "I-IV": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "I-I": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "plans_three": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
          "additionalProperties": false,
          "properties": {
            "I-V-I": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "I-IV-I": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "features": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
          "additionalProperties": false,
          "properties": {
            "dotted": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "leap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "repeat": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "leap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "low": {
              "type": "integer",
              "minimum": 3,
              "maximum": 12
            },
            "high": {
              "type": "integer",
              "minimum": 3,
              "maximum": 12,
              "description": "At least leap.low."
            }
          }
        },
        "rung_moves": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
          "additionalProperties": false,
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "skip": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "decorations": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
          "additionalProperties": false,
          "properties": {
            "chord_tone": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "passing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "neighbor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "appoggiatura": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "escape": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "durations": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
          "additionalProperties": false,
          "properties": {
            "half_beat": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "beat": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "two_beats": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "quarter_beats": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "long_short": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "short_long": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "triplet": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "triplet_two_beats": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "accented_one_in": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "An eligible note becomes an accented non-chord tone one time in this many; 0 never. Off by default."
        },
        "accented_types": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0. Which accented non-chord tone is placed.",
          "additionalProperties": false,
          "properties": {
            "appoggiatura": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "passing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "suspension": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "avoid_repeats": {
          "type": "boolean",
          "description": "No repeated note: decorations try the other kinds before a chord tone, and a repeat of a pitch is refused. Off by default."
        },
        "leaps_per_motif": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11,
          "description": "The most intervals of 5 semitones or more in a motive; 11 never rejects."
        },
        "leap_recovery": {
          "type": "boolean",
          "description": "A leap is followed by a move of 1 or 2 semitones the other way. Off by default."
        },
        "pickup_from_accent": {
          "type": "boolean",
          "description": "A pickup is one chord tone below segment a's first note and no longer than it; a motive that opens with an implied upbeat but has no pickup is refused. Off by default."
        },
        "contrast_fidelity_min": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$",
          "description": "n/d with 0 <= n <= d and d from 1 to 1000. The least recognizability of a contrasting segment against segment a; 0/1 never rejects."
        },
        "long_on_weak": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "The two-beat note is this much more likely on a weak beat (its weight times 1 plus this); 0 changes nothing."
        },
        "final_long": {
          "type": "boolean",
          "description": "The last note of the last segment is longer than every other note in it. Off by default."
        },
        "compound_beats": {
          "type": "boolean",
          "description": "In 6/8, 9/8 and 12/8 the beat is the dotted quarter: cells are tiled in beats of three eighths. No effect in any other meter. Off by default."
        },
        "endings": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0. How the last segment ends: free (as drawn), closed, open or lead_in. Free by default.",
          "additionalProperties": false,
          "properties": {
            "free": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "closed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "open": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "lead_in": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "long_nct_one_in": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "A segment gets a long non-chord tone (on a beat, a beat or longer, resolving to the next note) one time in this many; 0 never. Off by default."
        },
        "long_nct_types": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0. Which long non-chord tone is placed.",
          "additionalProperties": false,
          "properties": {
            "appoggiatura": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "suspension": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "retardation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "passing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "neighbor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "long_nct_intervals": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0. The tone's interval above the chord root.",
          "additionalProperties": false,
          "properties": {
            "second": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "fourth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "sixth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "seventh": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "long_nct_beats": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0. Where the tone sits: the downbeat, the middle of the bar, another beat.",
          "additionalProperties": false,
          "properties": {
            "downbeat": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "middle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "other": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "long_nct_lengths": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0. How long the tone is: a beat, a dotted beat, two beats or more.",
          "additionalProperties": false,
          "properties": {
            "beat": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "dotted_beat": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "two_beats": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "syncopation_one_in": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "A cell, and a segment boundary, gets a syncopation one time in this many; 0 never. Simple meters only, never on the motif's last note. Off by default."
        },
        "syncopation_types": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0. Which figure: an off-beat note held across the beat, a tie across the beat, a tie across the barline, or an anticipation of a new chord.",
          "additionalProperties": false,
          "properties": {
            "off_beat": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "tie_beat": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "tie_bar": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "anticipation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "syncopation_levels": {
          "type": "object",
          "description": "Whole-number weights 0 to 20; the sum of the entries is above 0. At which level: the short note a half beat (eighth) or a quarter beat (sixteenth).",
          "additionalProperties": false,
          "properties": {
            "eighth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "sixteenth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "skips_per_motif": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11,
          "description": "The most skips (intervals of 3 or 4 semitones) in a motif; 11 never rejects, the default."
        },
        "plan": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "description": "A given chord plan: Roman numerals I to VII in any case, an optional o or degree sign, an optional place @bar or @bar:beat (bar 1 or 2, beat 1 to 12). Either no chord has a place (at most 3 chords) or every chord after the first has one, rising. Absent by default: the plan is drawn.",
          "items": {
            "type": "string",
            "pattern": "^(?i:VII|VI|V|IV|III|II|I)(o|\u00b0)?(@[12](:([1-9]|1[0-2]))?)?$"
          }
        }
      }
    },
    "development": {
      "type": "object",
      "description": "The settings of the theme's development (docs/preferences.md).",
      "additionalProperties": false,
      "properties": {
        "fidelity_minimum": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "melody": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "presentation": {
                  "type": "string",
                  "pattern": "^[0-9]+/[0-9]+$",
                  "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                },
                "continuation": {
                  "type": "string",
                  "pattern": "^[0-9]+/[0-9]+$",
                  "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                },
                "cadential": {
                  "type": "string",
                  "pattern": "^[0-9]+/[0-9]+$",
                  "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                }
              }
            },
            "balanced": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "presentation": {
                  "type": "string",
                  "pattern": "^[0-9]+/[0-9]+$",
                  "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                },
                "continuation": {
                  "type": "string",
                  "pattern": "^[0-9]+/[0-9]+$",
                  "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                },
                "cadential": {
                  "type": "string",
                  "pattern": "^[0-9]+/[0-9]+$",
                  "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                }
              }
            },
            "theme": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "presentation": {
                  "type": "string",
                  "pattern": "^[0-9]+/[0-9]+$",
                  "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                },
                "continuation": {
                  "type": "string",
                  "pattern": "^[0-9]+/[0-9]+$",
                  "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                },
                "cadential": {
                  "type": "string",
                  "pattern": "^[0-9]+/[0-9]+$",
                  "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                }
              }
            }
          }
        },
        "continuation": {
          "type": "object",
          "description": "How a sentence's continuation accelerates (docs/grow-continuation.md). Every member is off by default.",
          "additionalProperties": false,
          "properties": {
            "every_segment": {
              "type": "boolean",
              "description": "Both fragments are drawn from every segment of the motif, never both from the same one."
            },
            "fragment_lengths": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0. A fragment is its whole segment, half a bar of it, or a beat of it. Segment alone by default.",
              "additionalProperties": false,
              "properties": {
                "segment": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "half_bar": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "beat": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "diminish": {
              "type": "boolean",
              "description": "A fragment that is a whole segment is that segment in diminution 1:2."
            },
            "liquidate": {
              "type": "boolean",
              "description": "Fragment 2 is liquidated, and the cadential idea liquidates a step further."
            },
            "faster_harmony": {
              "type": "boolean",
              "description": "An 8-bar sentence's continuation changes chord every cell and cadences on the cadential idea."
            }
          }
        },
        "basic_as_written": {
          "type": "boolean",
          "description": "A motif as long as the basic idea is the basic idea as written, over its own chords. Off by default."
        },
        "contrast": {
          "type": "object",
          "description": "How a theme's contrasting ideas contrast: a similar or a distant rhythm, or new material. All 0 reads as similar 1.",
          "additionalProperties": false,
          "properties": {
            "distance": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "similar": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "distant": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "new_material": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "functions": {
          "type": "object",
          "description": "Themes whose ideas follow their formal function (R-710 to R-712). Every member is off by default.",
          "additionalProperties": false,
          "properties": {
            "harmony": {
              "type": "boolean",
              "description": "Each idea of an antecedent and of an ending takes its harmony from its formal function."
            },
            "surface": {
              "type": "boolean",
              "description": "The fragments of a continuation are drawn from the busiest segment and another."
            },
            "contrast": {
              "type": "boolean",
              "description": "A contrasting idea is drawn to meet its function's contrast target in rhythm, contour, register and density."
            }
          }
        }
      }
    },
    "candidates": {
      "type": "object",
      "description": "How a set of random motives is chosen (R-673). Off by default.",
      "additionalProperties": false,
      "properties": {
        "variety": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "How much a motive is chosen for being unlike the ones before it. 0 leaves the draw as it was."
        },
        "pool": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8,
          "description": "How many candidates are drawn for each motive that is chosen among. Default 4."
        }
      }
    },
    "critic": {
      "type": "object",
      "description": "The critic (R-722): how a candidate is judged in her words, and whether a theme is chosen among candidates by it. Off by default.",
      "additionalProperties": false,
      "properties": {
        "rank": {
          "type": "boolean",
          "description": "Choose the theme among several candidates by the critic's score. Default false."
        },
        "candidates": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8,
          "description": "How many candidates are made for each theme kept. Default 4."
        },
        "keep_rejected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "description": "How many rejected candidates a run reports. Default 8."
        },
        "reverse": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "rhythmic_monotony",
              "contrast_distance",
              "leap_load",
              "open_ending",
              "stray_syncopation",
              "one_rhythm",
              "repeated_notes",
              "wide_range"
            ]
          },
          "description": "Evaluators whose penalty counts for a candidate instead of against it."
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "description": "The weight of each evaluator, 0 to 20.",
          "properties": {
            "rhythmic_monotony": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "Bars that keep one rhythm, run after run. Weight 0 to 20; default 1."
            },
            "contrast_distance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "A contrasting idea too close to the basic idea in rhythm and contour, or too far in register. Weight 0 to 20; default 1."
            },
            "leap_load": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "Skips and leaps, a third counting half a leap. Weight 0 to 20; default 1."
            },
            "open_ending": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "A last note no longer than the line's mean note. Weight 0 to 20; default 1."
            },
            "stray_syncopation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "A syncopation that never comes back. Weight 0 to 20; default 1."
            },
            "one_rhythm": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "Candidates of one set that open with one rhythm. Weight 0 to 20; default 1."
            },
            "repeated_notes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "Repeated notes. Weight 0 to 20; default 1."
            },
            "wide_range": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "A range wider than a tenth. Weight 0 to 20; default 1."
            }
          }
        }
      }
    }
  }
}
