{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz-Composer/schema/api/piece_variations.response.schema.json",
  "title": "composer_api_piece_variations response",
  "description": "The variations kept, each with its loop version (its plan inline), the loop markers of its MIDI file and, when asked, its MusicXML.",
  "type": "object",
  "required": [
    "schema",
    "section",
    "lane",
    "brief",
    "variations",
    "kept",
    "requested",
    "seeds_tried"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ursatz-piece-variations"
    },
    "section": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "brief": {
      "type": "object",
      "required": [
        "tempo",
        "mode",
        "density",
        "without"
      ],
      "additionalProperties": false,
      "properties": {
        "tempo": {
          "type": "object",
          "required": [
            "qpm",
            "from"
          ],
          "additionalProperties": false,
          "properties": {
            "qpm": {
              "type": [
                "number",
                "null"
              ]
            },
            "from": {
              "enum": [
                "option",
                "style",
                "none"
              ]
            }
          }
        },
        "mode": {
          "type": "object",
          "required": [
            "mode",
            "from"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "major",
                "minor"
              ]
            },
            "from": {
              "enum": [
                "request",
                "style"
              ]
            }
          }
        },
        "density": {
          "type": [
            "number",
            "null"
          ]
        },
        "without": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "variations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "seed"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "seed": {
            "type": "integer"
          },
          "loop": {
            "$ref": "#/$defs/version"
          },
          "piece": {
            "$ref": "#/$defs/version",
            "description": "The version of a form with sizes."
          },
          "loop_markers": {
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^[0-9]+/[0-9]+$"
              },
              "end": {
                "type": "string",
                "pattern": "^[0-9]+/[0-9]+$"
              }
            }
          },
          "musicxml": {
            "type": "string"
          }
        },
        "oneOf": [
          {
            "required": [
              "loop"
            ]
          },
          {
            "required": [
              "piece"
            ]
          }
        ]
      }
    },
    "kept": {
      "type": "integer"
    },
    "requested": {
      "type": "integer"
    },
    "seeds_tried": {
      "type": "integer"
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "required": [
        "plan",
        "sections",
        "score",
        "seam",
        "analyzer_check",
        "style_distance"
      ],
      "additionalProperties": false,
      "properties": {
        "plan": {
          "type": [
            "object",
            "null"
          ],
          "description": "The plan object (variations), else null: the plans of a piece are in \"plans\"."
        },
        "sections": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/loop_row"
              },
              {
                "$ref": "#/$defs/size_row"
              }
            ]
          }
        },
        "score": {
          "type": "object",
          "required": [
            "numerator",
            "denominator"
          ],
          "additionalProperties": false,
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 0
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "seam": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "progression",
                "no_parallels",
                "step",
                "leading_tone",
                "held"
              ],
              "additionalProperties": false,
              "properties": {
                "progression": {
                  "type": "boolean"
                },
                "no_parallels": {
                  "type": "boolean"
                },
                "step": {
                  "type": "boolean"
                },
                "leading_tone": {
                  "type": "boolean"
                },
                "held": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "analyzer_check": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "planned",
                "agreed",
                "contradicts",
                "items"
              ],
              "additionalProperties": false,
              "properties": {
                "planned": {
                  "type": "integer"
                },
                "agreed": {
                  "type": "integer"
                },
                "contradicts": {
                  "type": "boolean"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "kind",
                      "bar",
                      "planned",
                      "heard",
                      "agreed"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "enum": [
                          "cadence",
                          "key",
                          "violation"
                        ]
                      },
                      "bar": {
                        "type": "integer"
                      },
                      "planned": {
                        "type": "string"
                      },
                      "heard": {
                        "type": "string"
                      },
                      "agreed": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "style_distance": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          ]
        }
      }
    },
    "loop_row": {
      "type": "object",
      "required": [
        "id",
        "part",
        "letter",
        "start",
        "beats",
        "cadence",
        "heard",
        "fill",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "part": {
          "enum": [
            "intro",
            "body",
            "turnaround",
            "ending"
          ]
        },
        "letter": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        },
        "beats": {
          "type": "integer",
          "minimum": 1
        },
        "cadence": {
          "type": [
            "string",
            "null"
          ]
        },
        "heard": {
          "type": [
            "string",
            "null"
          ]
        },
        "in_scope": {
          "const": false,
          "description": "Present when a regenerate left the section as it was."
        },
        "fill": {
          "enum": [
            "empty",
            "motif",
            "theme",
            "progression"
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "description": "A section of a form whose sections the request gives (the game loop)."
    },
    "size_row": {
      "type": "object",
      "required": [
        "id",
        "role",
        "letter",
        "start",
        "beats",
        "cadence",
        "heard",
        "returns",
        "motive",
        "key_heard",
        "pedal",
        "changes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "theme",
            "contrast",
            "return",
            "variation",
            "layer",
            "intro",
            "body",
            "turnaround",
            "ending"
          ]
        },
        "letter": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        },
        "beats": {
          "type": "integer",
          "minimum": 1
        },
        "cadence": {
          "type": [
            "string",
            "null"
          ]
        },
        "heard": {
          "type": [
            "string",
            "null"
          ]
        },
        "in_scope": {
          "const": false,
          "description": "Present when a regenerate left the section as it was."
        },
        "returns": {
          "type": [
            "string",
            "null"
          ],
          "description": "The name of the section it returns."
        },
        "motive": {
          "type": [
            "string",
            "null"
          ],
          "description": "How its motive is made from the first, as the form's document writes it."
        },
        "key_heard": {
          "type": [
            "string",
            "null"
          ],
          "description": "The key the Analyzer heard at the section's start over the whole piece, as \"C major\"; null when none was heard."
        },
        "pedal": {
          "enum": [
            "dominant",
            null
          ],
          "description": "\"dominant\" when the section's first half was written over a dominant pedal."
        },
        "changes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/changes"
            }
          ],
          "description": "How a section that returns another differs from it; null for a section that returns none."
        }
      },
      "description": "A section of the size of a form with sizes."
    },
    "changes": {
      "type": "object",
      "required": [
        "copied",
        "variation",
        "melody_added",
        "chords_changed",
        "chords",
        "cadence_from",
        "cadence_to",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "copied": {
          "type": "boolean",
          "description": "The section holds a copy of the section it returns (same length, meter and key-lane shape); false when it was composed anew."
        },
        "variation": {
          "type": "string"
        },
        "melody_added": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "chords_changed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "chords": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cadence_from": {
          "type": [
            "string",
            "null"
          ],
          "description": "The numerals of the returned section's last quarter."
        },
        "cadence_to": {
          "type": [
            "string",
            "null"
          ],
          "description": "The numerals of the section's last quarter."
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "How a returned section differs from its source."
    }
  }
}
