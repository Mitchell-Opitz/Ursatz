{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz/composer/schema/api/piece.request.schema.json",
  "title": "composer_api_piece request",
  "description": "The piece request of docs/piece-request.md with a theme fill carrying its plan object, an earlier plan to regenerate a section of, and the options of the piece command as members. Schema version 2 names a built-in form.",
  "type": "object",
  "required": [
    "request"
  ],
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "integer"
    },
    "request": {
      "$ref": "#/$defs/piece_request"
    },
    "seed": {
      "type": [
        "integer",
        "string"
      ]
    },
    "check": {
      "type": "boolean"
    },
    "style": {
      "type": [
        "string",
        "null"
      ]
    },
    "plain_midi": {
      "type": "boolean"
    },
    "layers": {
      "type": "boolean",
      "description": "Also return the realization and the reading of the first result as \"realization\" and \"reading\"."
    },
    "from": {
      "$ref": "#/$defs/plan"
    },
    "regenerate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "lanes": {
          "type": "array",
          "items": {
            "enum": [
              "harmony",
              "bass",
              "melody",
              "inner",
              "all"
            ]
          }
        }
      }
    },
    "midi": {
      "type": "boolean"
    },
    "musicxml": {
      "type": "boolean"
    },
    "ending_musicxml": {
      "type": "boolean"
    },
    "musicxml_versions": {
      "type": "boolean",
      "description": "The MusicXML of every version after the first, as \"musicxml_versions\" in the document."
    },
    "explain": {
      "enum": [
        "text",
        "json"
      ]
    }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "type": "string"
        }
      },
      "description": "A plan object (library/docs/modules/plan-format.md, library/plan/schema/plan.v6.schema.json)."
    },
    "piece_request": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "key",
        "meter"
      ],
      "properties": {
        "schema": {
          "const": "ursatz-piece-request"
        },
        "schema_version": {
          "enum": [
            1,
            2
          ],
          "description": "1 is the game loop; 2 names a form in \"form\"."
        },
        "form": {
          "type": [
            "string",
            "null"
          ],
          "description": "Schema version 2: the name of a built-in form (composer_api_forms). Absent for version 1, the game loop."
        },
        "key": {
          "type": "string"
        },
        "material": {
          "type": "string",
          "description": "A material: a K1 id, name, key word or alias (omt.material.major, \"major\", \"minor\"), or \"style\" for the style's. The Composer writes keys in major and natural minor. With a key that is a tonic alone it gives the mode of the key. The old member \"mode\" is read as before; give material or mode, not both."
        },
        "mode": {
          "enum": [
            "major",
            "minor",
            "style"
          ],
          "description": "The old name of material, read as before (major, minor or style). Give material or mode, not both."
        },
        "meter": {
          "type": "string"
        },
        "motive": {
          "type": [
            "object",
            "null"
          ]
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/loop_section"
              },
              {
                "$ref": "#/$defs/overlay_section"
              }
            ]
          },
          "description": "The game loop's sections (version 1 and the game loop), or for a form with sizes the overlays: the sections of its size given a region, a motif with a motive of its own or a theme."
        },
        "accompaniment": {
          "type": [
            "object",
            "null"
          ]
        },
        "voicing": {
          "enum": [
            "satb",
            "chorale",
            null
          ]
        },
        "style": {
          "type": [
            "string",
            "null"
          ]
        },
        "style_weight": {
          "type": [
            "string",
            "null"
          ]
        },
        "without": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "tempo": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "bars": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 512,
          "description": "A form with sizes: the size in bars; 0 or absent for the default."
        },
        "count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 64,
          "description": "A form with sizes: the variations or layers; 0 or absent for the size bars gives."
        },
        "modulate": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "A form with regions: plan the keys of the sections from the seed."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 1
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "required": [
              "sections"
            ],
            "properties": {
              "form": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 2
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "required": [
              "form"
            ]
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "material"
          ]
        },
        {
          "required": [
            "mode"
          ]
        }
      ],
      "not": {
        "required": [
          "material",
          "mode"
        ]
      }
    },
    "loop_section": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "part": {
          "enum": [
            "intro",
            "body",
            "turnaround",
            "ending"
          ],
          "description": "The old name of role; give role or part, not both."
        },
        "letter": {
          "type": [
            "string",
            "null"
          ]
        },
        "beats": {
          "type": "integer",
          "minimum": 1
        },
        "pickup": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "cadence": {
          "enum": [
            "PAC",
            "IAC",
            "HC",
            "DC",
            "PC",
            null
          ]
        },
        "function": {
          "enum": [
            "transition",
            "coda",
            null
          ],
          "description": "The part of a larger form the section is (R-508): a transition on any body section but the ending, a coda on the ending; absent or null for none."
        },
        "fill": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "empty",
                    "motif",
                    "theme",
                    "progression"
                  ]
                },
                "plan": {
                  "$ref": "#/$defs/plan",
                  "description": "theme: the plan object of the theme"
                },
                "source": {
                  "type": "string",
                  "description": "theme: the name shown as the section's source"
                }
              }
            }
          ]
        },
        "role": {
          "enum": [
            "intro",
            "body",
            "turnaround",
            "ending"
          ],
          "description": "The name of part in the section description; give role or part, not both (R-610)."
        },
        "bars": {
          "type": "integer",
          "minimum": 1,
          "description": "The length in bars; beats or bars (R-605)."
        },
        "region": {
          "$ref": "https://github.com/Mitchell-Opitz/Ursatz/library/plan/schema/section.schema.json#/$defs/region",
          "description": "The key the section is in (R-610): home, {tonic, material} or {relation, anchor}."
        },
        "harmony": {
          "$ref": "https://github.com/Mitchell-Opitz/Ursatz/library/plan/schema/section.schema.json#/$defs/harmony",
          "description": "The section's harmony, given before it is composed (R-610): a progression, a galant schema or chords at bars."
        }
      },
      "anyOf": [
        {
          "required": [
            "part"
          ]
        },
        {
          "required": [
            "role"
          ]
        }
      ],
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "beats"
              ]
            },
            {
              "required": [
                "bars"
              ]
            }
          ]
        }
      ]
    },
    "overlay_section": {
      "type": "object",
      "required": [
        "name"
      ],
      "description": "A section of a form that takes its sections from its size, given something of its own (R-610).",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31,
          "description": "A section of the form's size."
        },
        "region": {
          "$ref": "https://github.com/Mitchell-Opitz/Ursatz/library/plan/schema/section.schema.json#/$defs/region"
        },
        "fill": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "empty",
                    "motif",
                    "theme"
                  ]
                },
                "motive": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "motif: the section's own motive"
                },
                "plan": {
                  "$ref": "#/$defs/plan",
                  "description": "theme: the plan object of the theme"
                },
                "source": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "harmony": {
          "$ref": "https://github.com/Mitchell-Opitz/Ursatz/library/plan/schema/section.schema.json#/$defs/harmony",
          "description": "The section's harmony, given before it is composed (R-610): a progression, a galant schema or chords at bars."
        }
      }
    }
  }
}
