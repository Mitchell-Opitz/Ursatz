{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz/composer/schema/api/progression.request.schema.json",
  "title": "composer_api_progression request",
  "description": "A chord progression for one phrase, or (list_schemas) the names of the schemas and sequences.",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "list_schemas"
      ]
    },
    {
      "required": [
        "key",
        "meter",
        "bars",
        "cadence"
      ]
    }
  ],
  "properties": {
    "api_version": {
      "type": "integer"
    },
    "list_schemas": {
      "type": "boolean"
    },
    "key": {
      "type": "string"
    },
    "meter": {
      "type": "string"
    },
    "bars": {
      "type": [
        "integer",
        "string"
      ]
    },
    "cadence": {
      "enum": [
        "PAC",
        "IAC",
        "HC",
        "DC",
        "PC",
        "pac",
        "iac",
        "hc",
        "dc",
        "pc",
        "none",
        "NONE",
        "None"
      ]
    },
    "seed": {
      "type": [
        "integer",
        "string"
      ]
    },
    "embellish": {
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ]
    },
    "bass": {
      "type": "boolean"
    },
    "schema": {
      "type": "string"
    },
    "sequence": {
      "type": "string"
    },
    "suggest": {
      "type": [
        "integer",
        "string"
      ]
    },
    "midi": {
      "type": "boolean"
    },
    "musicxml": {
      "type": "boolean"
    },
    "plain_midi": {
      "type": "boolean"
    },
    "tempo": {
      "type": [
        "integer",
        "string"
      ]
    },
    "plans": {
      "type": "boolean"
    },
    "layers": {
      "type": "boolean",
      "description": "Also return the realization and the reading of the first result as \"realization\" and \"reading\"."
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "description": "Chords drawn from one or two modes on the key's tonic (R-766); with it the cadence may be none, and schema, sequence and embellish are refused.",
      "properties": {
        "with": {
          "type": "string"
        },
        "chords_per_bar": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "spans": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bars"
            ],
            "properties": {
              "bars": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "chords": {
                "enum": [
                  "shared",
                  "color",
                  "first",
                  "second",
                  "any"
                ]
              },
              "schema": {
                "type": "string"
              },
              "loop": {
                "type": "boolean"
              }
            }
          }
        },
        "chords": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bar",
              "text"
            ],
            "properties": {
              "bar": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "brightness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape"
          ],
          "properties": {
            "shape": {
              "enum": [
                "rise",
                "fall",
                "hold",
                "peak",
                "step"
              ]
            },
            "at": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "tension": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape"
          ],
          "properties": {
            "shape": {
              "enum": [
                "rise",
                "fall",
                "hold",
                "peak",
                "step"
              ]
            },
            "at": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "accompaniment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern"
      ],
      "description": "With a palette: the accompaniment the chords are sounded with, a pattern name or a K11 accompaniment id and a K3 voicing id.",
      "properties": {
        "pattern": {
          "type": "string"
        },
        "voicing": {
          "type": "string"
        }
      }
    }
  }
}
