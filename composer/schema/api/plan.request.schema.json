{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz-Composer/schema/api/plan.request.schema.json",
  "title": "composer_api_plan request",
  "description": "The plan of a whole short piece: form, key, meter, motive and given material.",
  "type": "object",
  "required": [
    "key",
    "meter"
  ],
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "type": "integer"
    },
    "form": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "material": {
      "type": "string",
      "description": "A material: a K1 id, name, key word or alias (omt.material.major, \"major\", \"minor\"). The Composer writes keys in major and natural minor. With a key that is a tonic alone it gives the mode of the key. The old member \"mode\" is read as before; give material or mode, not both."
    },
    "mode": {
      "type": "string",
      "description": "The old name of material, read as before (major or minor). Give material or mode, not both."
    },
    "meter": {
      "type": "string"
    },
    "bars": {
      "type": [
        "integer",
        "string"
      ]
    },
    "count": {
      "type": [
        "integer",
        "string"
      ]
    },
    "modulate": {
      "type": "boolean"
    },
    "motive": {
      "type": "object",
      "required": [
        "input"
      ],
      "properties": {
        "input": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "format": {
              "type": "string"
            },
            "form": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "corpus": {
      "type": "string"
    },
    "like": {
      "type": "string"
    },
    "accompaniment": {
      "type": "string"
    },
    "texture": {
      "type": "string"
    },
    "seed": {
      "type": [
        "integer",
        "string"
      ]
    },
    "given": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "melody",
              "progression",
              "like_progression",
              "bass"
            ]
          },
          "numerals": {
            "type": "string"
          },
          "motive": {
            "type": "object",
            "required": [
              "input"
            ],
            "properties": {
              "input": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "format": {
                    "type": "string"
                  },
                  "form": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "source": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "at": {
            "type": "string"
          },
          "cells": {
            "type": [
              "integer",
              "string"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "style": {
      "type": "string"
    },
    "style_weight": {
      "type": "string"
    },
    "style_without": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    },
    "blend": {
      "type": "string"
    },
    "blend_weight": {
      "type": "string"
    },
    "blend_weights": {
      "type": "string"
    }
  },
  "not": {
    "required": [
      "material",
      "mode"
    ]
  }
}
