{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz/composer/schema/api/palette.response.schema.json",
  "title": "composer_api_palette response",
  "description": "The chords of the key's material and of the second material, the ones both hold and the color carriers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "materials",
    "shared",
    "color"
  ],
  "properties": {
    "key": {
      "type": "string"
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "material",
          "word",
          "chords"
        ],
        "properties": {
          "material": {
            "type": "string"
          },
          "word": {
            "type": "string"
          },
          "chords": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "degree",
                "numeral",
                "name",
                "quality",
                "shared",
                "color"
              ],
              "properties": {
                "degree": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                },
                "numeral": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "quality": {
                  "enum": [
                    "major",
                    "minor",
                    "diminished",
                    "augmented"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "shared": {
                  "type": "boolean"
                },
                "color": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "shared": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "color": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "material",
          "numerals"
        ],
        "properties": {
          "material": {
            "type": "string"
          },
          "numerals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
