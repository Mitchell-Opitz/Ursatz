{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz-Composer/schema/api/piece.response.schema.json",
  "title": "composer_api_piece response",
  "description": "What `piece --format json` prints (without the files it wrote), with the plans of both versions, and the explanation and the ending version's MusicXML when asked.",
  "type": "object",
  "required": [
    "schema",
    "seed",
    "key",
    "meter",
    "brief",
    "loop",
    "versions",
    "plans"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ursatz-piece"
    },
    "seed": {
      "type": "integer"
    },
    "key": {
      "type": "string"
    },
    "meter": {
      "type": "string"
    },
    "brief": {
      "type": "object",
      "required": [
        "tempo",
        "mode",
        "density",
        "without"
      ],
      "additionalProperties": false,
      "properties": {
        "tempo": {
          "type": "object",
          "required": [
            "qpm",
            "from"
          ],
          "additionalProperties": false,
          "properties": {
            "qpm": {
              "type": [
                "number",
                "null"
              ]
            },
            "from": {
              "enum": [
                "option",
                "style",
                "none"
              ]
            }
          }
        },
        "mode": {
          "type": "object",
          "required": [
            "mode",
            "from"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "major",
                "minor"
              ]
            },
            "from": {
              "enum": [
                "request",
                "style"
              ]
            }
          }
        },
        "density": {
          "type": [
            "number",
            "null"
          ]
        },
        "without": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "loop": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^[0-9]+/[0-9]+$"
            },
            "end": {
              "type": "string",
              "pattern": "^[0-9]+/[0-9]+$"
            }
          }
        }
      ]
    },
    "regenerated": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "section",
            "lane"
          ],
          "additionalProperties": false,
          "properties": {
            "section": {
              "type": "string"
            },
            "lane": {
              "type": "string",
              "description": "all, a lane, or lanes joined with +"
            }
          }
        }
      ]
    },
    "versions": {
      "type": "object",
      "required": [
        "loop",
        "ending"
      ],
      "additionalProperties": false,
      "properties": {
        "loop": {
          "$ref": "#/$defs/version"
        },
        "ending": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "plans": {
      "type": "object",
      "required": [
        "loop",
        "ending"
      ],
      "additionalProperties": false,
      "properties": {
        "loop": {
          "$ref": "#/$defs/plan"
        },
        "ending": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    "explanation": {
      "type": "string"
    },
    "ending_musicxml": {
      "type": "string"
    }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "type": "string"
        }
      },
      "description": "A plan object (docs/plan-format.md, schema/plan.v2.schema.json)."
    },
    "version": {
      "type": "object",
      "required": [
        "plan",
        "sections",
        "score",
        "seam",
        "analyzer_check",
        "style_distance"
      ],
      "additionalProperties": false,
      "properties": {
        "plan": {
          "type": [
            "object",
            "null"
          ],
          "description": "The plan object (variations), else null: the plans of a piece are in \"plans\"."
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "part",
              "letter",
              "start",
              "beats",
              "cadence",
              "heard",
              "fill",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "part": {
                "enum": [
                  "intro",
                  "body",
                  "turnaround",
                  "ending"
                ]
              },
              "letter": {
                "type": "string"
              },
              "start": {
                "type": "string",
                "pattern": "^[0-9]+/[0-9]+$"
              },
              "beats": {
                "type": "integer",
                "minimum": 1
              },
              "cadence": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "heard": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "in_scope": {
                "const": false,
                "description": "Present when a regenerate left the section as it was."
              },
              "fill": {
                "enum": [
                  "empty",
                  "motif",
                  "theme",
                  "progression"
                ]
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "score": {
          "type": "object",
          "required": [
            "numerator",
            "denominator"
          ],
          "additionalProperties": false,
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 0
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "seam": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "progression",
                "no_parallels",
                "step",
                "leading_tone",
                "held"
              ],
              "additionalProperties": false,
              "properties": {
                "progression": {
                  "type": "boolean"
                },
                "no_parallels": {
                  "type": "boolean"
                },
                "step": {
                  "type": "boolean"
                },
                "leading_tone": {
                  "type": "boolean"
                },
                "held": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "analyzer_check": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "planned",
                "agreed",
                "contradicts",
                "items"
              ],
              "additionalProperties": false,
              "properties": {
                "planned": {
                  "type": "integer"
                },
                "agreed": {
                  "type": "integer"
                },
                "contradicts": {
                  "type": "boolean"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "kind",
                      "bar",
                      "planned",
                      "heard",
                      "agreed"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "enum": [
                          "cadence",
                          "key",
                          "violation"
                        ]
                      },
                      "bar": {
                        "type": "integer"
                      },
                      "planned": {
                        "type": "string"
                      },
                      "heard": {
                        "type": "string"
                      },
                      "agreed": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "style_distance": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          ]
        }
      }
    }
  }
}
