{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz-Composer/schema/api/grow.request.schema.json",
  "title": "composer_api_grow request",
  "description": "A theme grown from a motive (or a corpus passage): the motive request with the brief of the command.",
  "type": "object",
  "required": [
    "into",
    "key",
    "meter"
  ],
  "properties": {
    "api_version": {
      "type": "integer"
    },
    "input": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string"
        },
        "form": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "pickup": {
      "type": [
        "number",
        "string"
      ]
    },
    "harmony": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "enum": [
        "melodic",
        "accompaniment"
      ]
    },
    "tones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "midi": {
      "type": "boolean"
    },
    "musicxml": {
      "type": "boolean"
    },
    "plain_midi": {
      "type": "boolean"
    },
    "tempo": {
      "type": [
        "integer",
        "string"
      ]
    },
    "plans": {
      "type": "boolean"
    },
    "meter": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "corpus": {
      "type": "string"
    },
    "like": {
      "type": "string"
    },
    "into": {
      "enum": [
        "sentence",
        "period",
        "hybrid"
      ]
    },
    "hybrid": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "bars": {
      "type": [
        "integer",
        "string"
      ]
    },
    "cadence": {
      "type": "string"
    },
    "first_cadence": {
      "type": "string"
    },
    "accompaniment": {
      "type": "string"
    },
    "accompaniment_motive": {
      "type": "object"
    },
    "texture": {
      "type": "string"
    },
    "voicing": {
      "type": "boolean"
    },
    "check": {
      "type": "boolean"
    },
    "style": {
      "type": "string"
    },
    "style_weight": {
      "type": "string"
    },
    "style_without": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "blend": {
      "type": "string"
    },
    "blend_weight": {
      "type": "string"
    },
    "blend_weights": {
      "type": "string"
    },
    "seed": {
      "type": [
        "integer",
        "string"
      ]
    },
    "suggest": {
      "type": [
        "integer",
        "string"
      ]
    },
    "explain": {
      "enum": [
        "text",
        "json"
      ]
    }
  },
  "additionalProperties": false
}
