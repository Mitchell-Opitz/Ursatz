{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz-Composer/schema/api/forms.schema.json",
  "title": "composer_api_forms response",
  "description": "The built-in forms: their sizes, sections, cadences, keys and theme slots, and the roles of a form whose sections the request gives (docs/api/vocabulary-and-validation.md, \"Forms\").",
  "type": "object",
  "required": [
    "forms"
  ],
  "additionalProperties": false,
  "properties": {
    "forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/form"
      }
    }
  },
  "$defs": {
    "choice": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "object",
      "required": [
        "value",
        "label",
        "loop"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "loop": {
          "type": "boolean"
        },
        "after": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "required": [
        "modulate",
        "accompaniment",
        "voicing",
        "section_fills"
      ],
      "properties": {
        "modulate": {
          "type": "boolean"
        },
        "accompaniment": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "voicing": {
          "type": "boolean"
        },
        "section_fills": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "cadence": {
      "type": "object",
      "required": [
        "value",
        "label",
        "core"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "core": {
          "enum": [
            "PAC",
            "IAC",
            "HC",
            "DC",
            "PC"
          ]
        }
      },
      "additionalProperties": false
    },
    "keys": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "minLength": 1
        },
        "end": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "required": [
        "slot",
        "ideas"
      ],
      "properties": {
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "ideas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": [
        "name",
        "letter",
        "role",
        "bars",
        "beats",
        "beginning",
        "ending",
        "cadence",
        "closed",
        "keys",
        "motive",
        "returns",
        "variation",
        "setting",
        "layers",
        "pedal",
        "slots",
        "leads_in",
        "connective",
        "figure",
        "mode",
        "independent",
        "lyric",
        "labels"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "letter": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "$ref": "#/$defs/choice"
        },
        "bars": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "beats": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "beginning": {
          "description": "Null for a liquidation, a retransition and a coda: an operator grows them, they have no beginning.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/choice"
            }
          ]
        },
        "ending": {
          "description": "Null for a liquidation, a retransition and a coda: an operator grows them, they have no ending.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/choice"
            }
          ]
        },
        "cadence": {
          "$ref": "#/$defs/cadence"
        },
        "closed": {
          "type": "boolean"
        },
        "keys": {
          "$ref": "#/$defs/keys"
        },
        "motive": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "returns": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "variation": {
          "enum": [
            "exact",
            "ornament",
            "reharmonize",
            "reregister",
            "varied",
            "figurate",
            "embellish",
            "setting",
            null
          ]
        },
        "setting": {
          "enum": [
            "block",
            "arpeggiated",
            "alberti",
            "oom-pah",
            null
          ],
          "description": "The pattern of the new accompaniment of a setting return (R-518); null for any other section."
        },
        "layers": {
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "pedal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/choice"
            }
          ],
          "description": "The degree its presentation sits over in the bass: null, or the dominant pedal (R-446)."
        },
        "slots": {
          "description": "Null for a liquidation, a retransition and a coda: an operator grows them, they have no slots.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "construction": {
          "description": "Present when the section is a theme with a construction (R-468): \"auto\" when the Composer chooses it at build, or the construction as a theme's response gives it. A section without one has no member.",
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "object",
              "required": [
                "halves",
                "ideas",
                "extensions",
                "reason",
                "text"
              ],
              "properties": {
                "halves": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "ideas": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "idea",
                      "bars",
                      "first_bar"
                    ]
                  }
                },
                "extensions": {
                  "type": "array",
                  "maxItems": 3
                },
                "reason": {
                  "enum": [
                    "given",
                    "motive",
                    "length"
                  ]
                },
                "text": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "leads_in": {
          "type": "boolean",
          "description": "The section is held until the sections after it are written, then filled against them (R-486)."
        },
        "connective": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/choice"
            }
          ],
          "description": "Whether a section that leads into the next ends with a connective: \"sometimes\" or \"always\"; null for none."
        },
        "figure": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "rhythm",
                "harmony",
                "change_at",
                "climax"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "neighbor",
                    "scale",
                    "broken-chord"
                  ]
                },
                "rhythm": {
                  "enum": [
                    "eighths",
                    "sixteenths"
                  ]
                },
                "harmony": {
                  "enum": [
                    "kept",
                    "reharmonized"
                  ]
                },
                "change_at": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "climax": {
                  "type": "boolean"
                }
              }
            }
          ],
          "description": "The motive of variation of a figurate return (R-501): null for a section with none."
        },
        "mode": {
          "enum": [
            "parallel",
            "major",
            "home",
            null
          ],
          "description": "\"parallel\" for a section in the home key's parallel mode (R-499), \"major\" for a return in the home tonic's major key (R-517), \"home\" for a returning section at home in the home mode, its source copied across modes when it is in the other (R-524); null for any other."
        },
        "independent": {
          "type": "boolean",
          "description": "A transition made from a motive of its own (R-504)."
        },
        "lyric": {
          "type": "boolean",
          "description": "A subordinate theme whose motive is the main theme's, augmented (R-506)."
        },
        "labels": {
          "type": "object",
          "required": [
            "role",
            "return",
            "keys",
            "figure"
          ],
          "additionalProperties": false,
          "properties": {
            "role": {
              "type": "string"
            },
            "return": {
              "type": "string"
            },
            "keys": {
              "type": "string"
            },
            "figure": {
              "type": "string"
            }
          },
          "description": "The sentences the section is shown as (API 4.2): its role (then \" (independent)\" or \" (lyric)\"), what it returns (with its variation), its keys (with the mode) and its figure in words; \"\" for a member the section has none of."
        }
      },
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "required": [
        "bars",
        "count",
        "default",
        "sections",
        "label"
      ],
      "properties": {
        "bars": {
          "type": "integer",
          "minimum": 1
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "default": {
          "type": "boolean"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "label": {
          "type": "string",
          "description": "\"3 variations, 32 bars\" for a size with a count (the noun is the role of its last section), else \"16 bars\" (API 4.2)."
        }
      },
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "required": [
        "value",
        "label",
        "required"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "lastCadence": {
      "type": "object",
      "required": [
        "roles",
        "cadence"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cadence": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "cadences": {
      "type": "object",
      "required": [
        "default",
        "last"
      ],
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1
        },
        "last": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lastCadence"
          }
        }
      },
      "additionalProperties": false
    },
    "defaultEnding": {
      "type": "object",
      "required": [
        "id",
        "letter",
        "role",
        "bars",
        "cadence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "letter": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "bars": {
          "type": "integer",
          "minimum": 1
        },
        "cadence": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "form": {
      "type": "object",
      "required": [
        "name",
        "label",
        "closing",
        "modulates",
        "sections",
        "versions",
        "settings",
        "regions",
        "sizes",
        "roles",
        "loop_roles",
        "cadences",
        "default_ending",
        "meters",
        "tempo",
        "repeats",
        "parts",
        "performed"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "closing": {
          "type": "boolean"
        },
        "modulates": {
          "type": "boolean",
          "description": "The form's key plan always leaves home, whatever the request says (R-493): the modulate choice is not offered for it."
        },
        "sections": {
          "enum": [
            "request",
            "sizes"
          ]
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sizes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/size"
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "loop_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cadences": {
          "oneOf": [
            {
              "$ref": "#/$defs/cadences"
            },
            {
              "type": "null"
            }
          ]
        },
        "default_ending": {
          "oneOf": [
            {
              "$ref": "#/$defs/defaultEnding"
            },
            {
              "type": "null"
            }
          ]
        },
        "meters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The meters a piece of the form may be in, as \"3/4\"; [] for any."
        },
        "tempo": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Quarter notes a minute when the request and its style give none; null for none."
        },
        "repeats": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "The groups of sections written out twice in place, by name."
        },
        "parts": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "form",
                  "key",
                  "motive",
                  "again",
                  "repeats",
                  "bars"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "form": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/choice"
                      }
                    ],
                    "description": "The built-in form the part is a piece of; null for an again part."
                  },
                  "key": {
                    "type": "string",
                    "description": "\"home\", or the region its home key is drawn from."
                  },
                  "motive": {
                    "enum": [
                      "piece",
                      "new"
                    ],
                    "description": "\"new\" when the part invents a motive of its own."
                  },
                  "again": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The name of the earlier part it performs again."
                  },
                  "repeats": {
                    "type": "boolean",
                    "description": "Its repeats are written out."
                  },
                  "bars": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "description": "The size of the part's form it is composed at (R-495); null: the compound size's bars."
                  }
                }
              }
            }
          ],
          "description": "The parts of a compound form, composed each as a piece of its own and performed in order; null for any other."
        },
        "performed": {
          "type": "boolean",
          "description": "A piece of the form is performed in order: its composed plan is not what it renders (it has repeats or parts)."
        }
      },
      "additionalProperties": false
    }
  }
}
