{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz/composer/schema/api/counterpoint.request.schema.json",
  "title": "composer_api_counterpoint request",
  "description": "A counter-melody against a line: the line is a motive request of any length.",
  "type": "object",
  "required": [
    "input",
    "species",
    "key",
    "meter"
  ],
  "properties": {
    "api_version": {
      "type": "integer"
    },
    "input": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string"
        },
        "form": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "pickup": {
      "type": [
        "number",
        "string"
      ]
    },
    "harmony": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "enum": [
        "melodic",
        "accompaniment"
      ]
    },
    "tones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "midi": {
      "type": "boolean"
    },
    "musicxml": {
      "type": "boolean"
    },
    "plain_midi": {
      "type": "boolean"
    },
    "tempo": {
      "type": [
        "integer",
        "string"
      ]
    },
    "plans": {
      "type": "boolean"
    },
    "layers": {
      "type": "boolean",
      "description": "Also return the realization and the reading of the first result as \"realization\" and \"reading\"."
    },
    "meter": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "material": {
      "type": "string",
      "description": "A material: a K1 id, name, key word or alias (omt.material.major, \"major\", \"minor\"). The Composer writes keys in major and natural minor. With a key that is a tonic alone it gives the mode of the key. The old member \"mode\" is read as before; give material or mode, not both."
    },
    "mode": {
      "enum": [
        "major",
        "minor"
      ],
      "description": "The old name of material, read as before (major or minor). Give material or mode, not both."
    },
    "species": {
      "type": [
        "integer",
        "string"
      ]
    },
    "position": {
      "enum": [
        "above",
        "below"
      ]
    },
    "seed": {
      "type": [
        "integer",
        "string"
      ]
    },
    "suggest": {
      "type": [
        "integer",
        "string"
      ]
    }
  },
  "additionalProperties": false,
  "not": {
    "required": [
      "material",
      "mode"
    ]
  }
}
