{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz-Composer/schema/api/vocabulary.schema.json",
  "title": "composer_api_vocabulary response",
  "description": "The words an application offers and the requests accept (docs/api.md, \"Vocabularies\").",
  "type": "object",
  "required": [
    "meters",
    "materials",
    "piece_materials",
    "keys",
    "cadences",
    "theme_cadences",
    "motive_forms",
    "random_motive_strategies",
    "roles",
    "functions",
    "distances",
    "theme_slots",
    "theme_motive_categories",
    "theme_pools",
    "theme_bars",
    "theme_bars_regular",
    "theme_extensions",
    "theme_first_cadences",
    "theme_beginnings",
    "theme_endings",
    "style_weights",
    "accompaniment_patterns",
    "piece_parts",
    "piece_functions",
    "piece_intos",
    "fill_kinds",
    "pitch_class_names",
    "pickups",
    "theme_ideas",
    "tone_labels",
    "variant_operations",
    "preferences",
    "preference_keys",
    "rules",
    "relations",
    "schemas",
    "theme_developments",
    "lanes",
    "limits"
  ],
  "additionalProperties": false,
  "properties": {
    "theme_developments": {
      "type": "array",
      "minItems": 1,
      "description": "How far a theme may stray from its motif (API 1.9): the value a request carries, its label and the help an editor shows (API 4.1).",
      "items": {
        "type": "object",
        "required": [
          "value",
          "label",
          "help"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "help": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "description": "The lanes of a piece version a regenerate or a set of variations may name (API 4.1); all is every lane.",
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "description": "The galant schemas a section's harmony may name: those that make a chord of each stage in the major and the natural minor (R-610).",
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "description": "The relations of the knowledge snapshot (K6) a section's region may name, from an anchor (R-610).",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "meters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/meter"
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "piece_materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "cadences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "theme_cadences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "motive_forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "random_motive_strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "distances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "theme_slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/themeSlot"
      }
    },
    "theme_motive_categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "theme_pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "theme_bars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "theme_bars_regular": {
      "type": "array",
      "description": "The lengths that need no construction.",
      "items": {
        "type": "integer"
      }
    },
    "theme_extensions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/choice_extension"
      }
    },
    "theme_first_cadences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "theme_beginnings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/theme_part"
      }
    },
    "theme_endings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/theme_part"
      }
    },
    "style_weights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "accompaniment_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "piece_parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "piece_functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "label",
          "parts"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "transition",
              "coda"
            ]
          },
          "label": {
            "type": "string"
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "intro",
                "body",
                "turnaround",
                "ending"
              ]
            }
          }
        }
      },
      "description": "The functions a game loop section can be (R-510) and the parts each can be in."
    },
    "piece_intos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pieceInto"
      }
    },
    "fill_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "pitch_class_names": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "value",
          "names"
        ],
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          },
          "names": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            },
            "description": "The tonic's spelling in a key of each material, by the material's id."
          }
        },
        "additionalProperties": false
      }
    },
    "pickups": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[0-9]+(/[0-9]+)?$"
        }
      }
    },
    "theme_ideas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/idea"
      }
    },
    "tone_labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tone"
      }
    },
    "variant_operations": {
      "type": "object",
      "required": [
        "operations"
      ]
    },
    "limits": {
      "type": "object",
      "required": [
        "motive_notes",
        "motive_chords",
        "motive_features",
        "variant_chain",
        "variant_functions",
        "random_motive_count",
        "tempo_min",
        "tempo_max",
        "seed_max",
        "piece_sections",
        "piece_beats",
        "theme_motives",
        "theme_extensions",
        "piece_variations",
        "harmony_cells",
        "preferences",
        "construction_bars",
        "construction_pickup"
      ],
      "additionalProperties": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "$ref": "#/$defs/seed_max"
          },
          {
            "$ref": "#/$defs/preference_limits"
          }
        ]
      },
      "properties": {
        "seed_max": {
          "$ref": "#/$defs/seed_max"
        },
        "preferences": {
          "$ref": "#/$defs/preference_limits"
        },
        "construction_bars": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "The whole bars a theme may have with a construction (R-468): from min to max, beside theme_bars_regular (API 4.2)."
        },
        "construction_pickup": {
          "type": "boolean",
          "description": "Whether a theme with a construction may have a pickup: false (API 4.2)."
        }
      }
    },
    "preferences": {
      "$ref": "https://github.com/Mitchell-Opitz/Ursatz-Composer/schema/api/preferences.schema.json",
      "description": "The default settings document."
    },
    "preference_keys": {
      "type": "array",
      "description": "The setting keys (Composer API 4.3): one per leaf of the default preferences document, in its order, and motif.plan, which the default document does not hold.",
      "items": {
        "type": "object",
        "required": [
          "key",
          "type",
          "class"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "description": "The dotted key, for example melody.weights.melodic."
          },
          "type": {
            "enum": [
              "integer",
              "boolean",
              "ratio",
              "words",
              "plan"
            ]
          },
          "min": {
            "type": "integer",
            "description": "The least value of an integer key."
          },
          "max": {
            "type": "integer",
            "description": "The greatest value of an integer key, or the denominator limit of a ratio key."
          },
          "words": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The words a words key may name."
          },
          "class": {
            "enum": [
              "hard",
              "soft"
            ],
            "description": "A hard setting changes what a request may ask for or what a candidate may be; a soft one is a preference."
          },
          "default": {
            "description": "The value the default document holds; absent for motif.plan."
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "description": "The rules a setting can override (Composer API 4.3): the soft groups and the hard rules of the melody stage.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "class",
          "key"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "class": {
            "enum": [
              "hard",
              "soft"
            ]
          },
          "key": {
            "type": "string",
            "description": "The setting that holds the rule: a weight for a soft group, melody.waive for a hard rule."
          }
        }
      }
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "required": [
        "id",
        "name",
        "family"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "enum": [
            "tonal",
            "modal",
            "neo-riemannian",
            "set",
            "serial"
          ]
        }
      },
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "themeSlot": {
      "type": "object",
      "required": [
        "value",
        "label",
        "required"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean",
          "description": "The slot every theme needs (the basic idea)."
        }
      },
      "additionalProperties": false
    },
    "pieceInto": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "beginning": {
          "type": "string",
          "minLength": 1,
          "description": "The value of theme_beginnings the archetype is made of; absent when it is made of several pairings."
        },
        "ending": {
          "type": "string",
          "minLength": 1,
          "description": "The value of theme_endings the archetype is made of; absent when it is made of several pairings."
        }
      },
      "additionalProperties": false
    },
    "meter": {
      "type": "object",
      "required": [
        "value",
        "label",
        "beats",
        "chord_onset_step"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        },
        "label": {
          "type": "string"
        },
        "beats": {
          "type": "integer",
          "minimum": 1
        },
        "chord_onset_step": {
          "type": "string"
        },
        "second_chord_beat": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "idea": {
      "type": "object",
      "required": [
        "value",
        "label",
        "slot"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "slot": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tone": {
      "type": "object",
      "required": [
        "value",
        "label",
        "abbreviation"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "abbreviation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "theme_part": {
      "type": "object",
      "required": [
        "value",
        "label",
        "ideas"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "ideas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "seed_max": {
      "type": "object",
      "required": [
        "variants",
        "random_motive",
        "theme",
        "piece"
      ],
      "properties": {
        "variants": {
          "type": "integer",
          "minimum": 1
        },
        "random_motive": {
          "type": "integer",
          "minimum": 1
        },
        "theme": {
          "type": "integer",
          "minimum": 1
        },
        "piece": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "preference_limits": {
      "type": "object",
      "description": "The limits of the settings document, as numbers.",
      "required": [
        "weight_max",
        "pickup_one_in_max",
        "accented_one_in_max",
        "long_nct_one_in_max",
        "leaps_per_motif_max",
        "syncopation_one_in_max",
        "skips_per_motif_max",
        "plan_chords_max",
        "plan_beat_max",
        "leap_min",
        "leap_max",
        "range_low_min",
        "range_low_max",
        "range_high_max",
        "range_span_min",
        "density_max",
        "scale_max",
        "climax_rise_min",
        "climax_rise_max",
        "ratio_denominator_max",
        "fidelity_denominator_max",
        "attempts_max",
        "keep_max",
        "pool_min",
        "pool_max"
      ],
      "additionalProperties": false,
      "properties": {
        "weight_max": {
          "type": "integer",
          "minimum": 1
        },
        "pickup_one_in_max": {
          "type": "integer",
          "minimum": 1
        },
        "accented_one_in_max": {
          "type": "integer",
          "minimum": 1
        },
        "long_nct_one_in_max": {
          "type": "integer",
          "minimum": 1
        },
        "leaps_per_motif_max": {
          "type": "integer",
          "minimum": 1
        },
        "leap_min": {
          "type": "integer",
          "minimum": 1
        },
        "leap_max": {
          "type": "integer",
          "minimum": 1
        },
        "range_low_min": {
          "type": "integer",
          "minimum": 1
        },
        "range_low_max": {
          "type": "integer",
          "minimum": 1
        },
        "range_high_max": {
          "type": "integer",
          "minimum": 1
        },
        "range_span_min": {
          "type": "integer",
          "minimum": 1
        },
        "density_max": {
          "type": "integer",
          "minimum": 1
        },
        "scale_max": {
          "type": "integer",
          "minimum": 1
        },
        "climax_rise_min": {
          "type": "integer",
          "minimum": 1
        },
        "climax_rise_max": {
          "type": "integer",
          "minimum": 1
        },
        "ratio_denominator_max": {
          "type": "integer",
          "minimum": 1
        },
        "fidelity_denominator_max": {
          "type": "integer",
          "minimum": 1
        },
        "attempts_max": {
          "type": "integer",
          "minimum": 1
        },
        "keep_max": {
          "type": "integer",
          "minimum": 1
        },
        "syncopation_one_in_max": {
          "type": "integer",
          "minimum": 1
        },
        "skips_per_motif_max": {
          "type": "integer",
          "minimum": 1
        },
        "plan_chords_max": {
          "type": "integer",
          "minimum": 1
        },
        "plan_beat_max": {
          "type": "integer",
          "minimum": 1
        },
        "rhythm_repeat_bars_max": {
          "type": "integer",
          "minimum": 1
        },
        "pool_min": {
          "type": "integer",
          "minimum": 1
        },
        "pool_max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "choice_extension": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "enum": [
            "repeat",
            "stretch",
            "addition",
            "evaded"
          ]
        },
        "label": {
          "type": "string"
        },
        "ideas": {
          "type": "array",
          "items": {
            "enum": [
              "basic idea",
              "repetition",
              "contrasting idea",
              "consequent basic idea",
              "consequent contrasting idea",
              "fragment 1",
              "fragment 2",
              "cadential",
              "cadential 1",
              "cadential 2"
            ]
          }
        },
        "varied": {
          "type": "boolean"
        }
      }
    }
  }
}
