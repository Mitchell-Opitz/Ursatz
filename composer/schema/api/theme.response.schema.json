{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz/composer/schema/api/theme.response.schema.json",
  "title": "composer_api_theme response",
  "description": "What `theme --format json` prints (without the files it wrote), and the plan and the explanation of each theme when asked.",
  "type": "object",
  "required": [
    "key",
    "meter",
    "bars",
    "into",
    "pairing",
    "cadence",
    "tempo",
    "brief",
    "chords",
    "themes"
  ],
  "additionalProperties": false,
  "properties": {
    "key": {
      "type": "string"
    },
    "meter": {
      "type": "string"
    },
    "bars": {
      "type": "integer",
      "minimum": 3,
      "maximum": 16
    },
    "into": {
      "type": "string"
    },
    "pairing": {
      "type": "string"
    },
    "cadence": {
      "type": "string"
    },
    "first_cadence": {
      "type": "string"
    },
    "accompaniment": {
      "type": "string"
    },
    "texture": {
      "type": "string"
    },
    "voicing": {
      "enum": [
        "satb",
        "chorale"
      ]
    },
    "tempo": {
      "type": "object",
      "required": [
        "qpm",
        "from"
      ],
      "properties": {
        "qpm": {
          "type": [
            "number",
            "null"
          ]
        },
        "from": {
          "enum": [
            "option",
            "style",
            "none"
          ]
        }
      },
      "additionalProperties": false
    },
    "brief": {
      "type": "object",
      "required": [
        "tempo",
        "material",
        "density",
        "without"
      ],
      "additionalProperties": false,
      "properties": {
        "tempo": {
          "type": "object",
          "required": [
            "qpm",
            "from"
          ],
          "properties": {
            "qpm": {
              "type": [
                "number",
                "null"
              ]
            },
            "from": {
              "enum": [
                "option",
                "style",
                "none"
              ]
            }
          },
          "additionalProperties": false
        },
        "material": {
          "type": "object",
          "required": [
            "material",
            "from"
          ],
          "properties": {
            "material": {
              "enum": [
                "omt.material.major",
                "omt.material.natural-minor"
              ]
            },
            "from": {
              "enum": [
                "request",
                "style"
              ]
            }
          },
          "additionalProperties": false
        },
        "density": {
          "type": [
            "number",
            "null"
          ]
        },
        "without": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "development": {
          "type": "string"
        }
      }
    },
    "chords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bar",
          "text"
        ],
        "properties": {
          "bar": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/theme"
      }
    },
    "preferences": {
      "$ref": "https://github.com/Mitchell-Opitz/Ursatz/composer/schema/api/preferences.schema.json",
      "description": "The full settings document, present when the request had the member."
    },
    "construction": {
      "type": "object",
      "description": "The construction as the request gave it.",
      "required": [
        "ideas",
        "extensions"
      ],
      "additionalProperties": false,
      "properties": {
        "ideas": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "basic idea",
              "repetition",
              "contrasting idea",
              "consequent basic idea",
              "consequent contrasting idea",
              "fragment 1",
              "fragment 2",
              "cadential",
              "cadential 1",
              "cadential 2"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "extensions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "idea",
              "bars",
              "varied"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "repeat",
                  "stretch",
                  "addition",
                  "evaded"
                ]
              },
              "idea": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bars": {
                "type": "integer",
                "minimum": 0
              },
              "varied": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "realization": {
      "$ref": "https://github.com/Mitchell-Opitz/Ursatz/library/realization/schema/realization.v1.schema.json",
      "description": "The work of the result as its MIDI and MusicXML are written from it, with layers: true."
    },
    "reading": {
      "$ref": "https://github.com/Mitchell-Opitz/Ursatz/library/reading/schema/reading.v1.schema.json",
      "description": "The Composer's hearing of the result over that realization, with layers: true."
    },
    "rejected": {
      "type": "array",
      "description": "With preferences critic.rank: the candidates the critic passed over, best first, at most critic.keep_rejected of them.",
      "items": {
        "type": "object",
        "required": [
          "seed",
          "score",
          "evaluators"
        ],
        "additionalProperties": false,
        "properties": {
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "score": {
            "type": "object",
            "required": [
              "numerator",
              "denominator"
            ],
            "additionalProperties": false,
            "properties": {
              "numerator": {
                "type": "integer"
              },
              "denominator": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "evaluators": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rule",
                "penalty",
                "weight",
                "reversed"
              ],
              "additionalProperties": false,
              "properties": {
                "rule": {
                  "enum": [
                    "rhythmic_monotony",
                    "contrast_distance",
                    "leap_load",
                    "open_ending",
                    "stray_syncopation",
                    "one_rhythm",
                    "repeated_notes",
                    "wide_range"
                  ]
                },
                "penalty": {
                  "type": "object",
                  "required": [
                    "numerator",
                    "denominator"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "numerator": {
                      "type": "integer"
                    },
                    "denominator": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "weight": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "reversed": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "theme": {
      "type": "object",
      "required": [
        "seed",
        "structure",
        "construction",
        "chords",
        "developments",
        "slots",
        "score",
        "requested",
        "heard",
        "heard_as_requested",
        "heard_text"
      ],
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "structure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind",
              "start",
              "end"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "form",
                  "section",
                  "phrase",
                  "subphrase",
                  "idea",
                  "motive"
                ]
              },
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "construction": {
          "type": [
            "object",
            "null"
          ],
          "description": "The construction of the theme as built (R-468), null for a theme without one.",
          "required": [
            "halves",
            "ideas",
            "extensions",
            "reason",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "halves": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "ideas": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "idea",
                  "bars",
                  "first_bar"
                ],
                "additionalProperties": false,
                "properties": {
                  "idea": {
                    "enum": [
                      "basic idea",
                      "repetition",
                      "contrasting idea",
                      "consequent basic idea",
                      "consequent contrasting idea",
                      "fragment 1",
                      "fragment 2",
                      "cadential",
                      "cadential 1",
                      "cadential 2"
                    ]
                  },
                  "bars": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "first_bar": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "extensions": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "idea",
                  "bars",
                  "first_bar",
                  "varied"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "repeat",
                      "stretch",
                      "addition",
                      "evaded"
                    ]
                  },
                  "idea": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "bars": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "first_bar": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "varied": {
                    "type": "boolean"
                  }
                }
              }
            },
            "reason": {
              "enum": [
                "given",
                "motive",
                "length"
              ]
            },
            "text": {
              "type": "string"
            }
          }
        },
        "chords": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "bar",
              "beat",
              "chord",
              "function",
              "bass"
            ],
            "properties": {
              "bar": {
                "type": "integer"
              },
              "beat": {
                "type": "integer"
              },
              "chord": {
                "type": "string"
              },
              "function": {
                "type": "string"
              },
              "bass": {
                "type": "string"
              },
              "borrowed_from": {
                "type": "string",
                "description": "The id of the material a borrowed chord is taken from (R-729); present only for a borrowed chord."
              }
            },
            "additionalProperties": false
          }
        },
        "developments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "motive",
              "idea",
              "development",
              "segment",
              "summary",
              "fidelity",
              "minimum",
              "heard",
              "heard_agrees"
            ],
            "properties": {
              "motive": {
                "type": "string"
              },
              "idea": {
                "type": "string"
              },
              "development": {
                "type": "string"
              },
              "segment": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "summary": {
                "type": "string"
              },
              "fidelity": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "minimum": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "heard": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "heard_agrees": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "idea",
              "slot",
              "motive",
              "source",
              "item",
              "chain",
              "connection"
            ],
            "properties": {
              "idea": {
                "type": "string"
              },
              "slot": {
                "enum": [
                  "basic",
                  "contrasting",
                  "continuation",
                  "cadential"
                ]
              },
              "motive": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "motive",
                  "idea",
                  "registry",
                  "operator",
                  "distant",
                  "new"
                ]
              },
              "item": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "chain": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "connection": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "score": {
          "type": "object",
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 0
            },
            "denominator": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "requested": {
          "type": "string"
        },
        "heard": {
          "type": [
            "string",
            "null"
          ]
        },
        "heard_as_requested": {
          "type": "boolean"
        },
        "heard_text": {
          "type": "string"
        },
        "contrasts": {
          "type": "array",
          "minItems": 1,
          "description": "Present only when an idea holds a contrast target (development.functions.contrast): how far its notes are from the idea it contrasts against, in each aspect (a number, 0 for alike).",
          "items": {
            "type": "object",
            "required": [
              "idea",
              "against",
              "rhythm",
              "contour",
              "register",
              "density"
            ],
            "additionalProperties": false,
            "properties": {
              "idea": {
                "type": "string"
              },
              "against": {
                "type": "string"
              },
              "rhythm": {
                "type": "number",
                "minimum": 0
              },
              "contour": {
                "type": "number",
                "minimum": 0
              },
              "register": {
                "type": "number",
                "minimum": 0
              },
              "density": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "style_distance": {
          "type": "object",
          "properties": {
            "harmony": {
              "type": "number"
            },
            "rhythm": {
              "type": "number"
            },
            "melody": {
              "type": "number"
            },
            "form": {
              "type": "number"
            },
            "overall": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "plan": {
          "type": "object",
          "description": "The plan of the theme, with plans: true."
        },
        "explanation": {
          "type": "string",
          "description": "The explanation of the theme, text or JSON text, with explain."
        },
        "critic": {
          "type": "object",
          "description": "The critic's judgment of the theme (preferences critic.rank): its score, each evaluator's penalty and the observations in plain words, as the critique entry gives them.",
          "required": [
            "score",
            "evaluators",
            "observations"
          ],
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "object",
              "required": [
                "numerator",
                "denominator"
              ],
              "additionalProperties": false,
              "properties": {
                "numerator": {
                  "type": "integer"
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "evaluators": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "rule",
                  "penalty",
                  "weight",
                  "reversed"
                ],
                "additionalProperties": false,
                "properties": {
                  "rule": {
                    "enum": [
                      "rhythmic_monotony",
                      "contrast_distance",
                      "leap_load",
                      "open_ending",
                      "stray_syncopation",
                      "one_rhythm",
                      "repeated_notes",
                      "wide_range"
                    ]
                  },
                  "penalty": {
                    "type": "object",
                    "required": [
                      "numerator",
                      "denominator"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "numerator": {
                        "type": "integer"
                      },
                      "denominator": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "reversed": {
                    "type": "boolean"
                  }
                }
              }
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "rule",
                  "scored",
                  "bar",
                  "beat",
                  "message"
                ],
                "additionalProperties": false,
                "properties": {
                  "rule": {
                    "type": "string"
                  },
                  "scored": {
                    "type": "boolean"
                  },
                  "bar": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "beat": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "numerator",
                          "denominator"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "numerator": {
                            "type": "integer"
                          },
                          "denominator": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
