{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz-Composer/schema/api/theme.response.schema.json",
  "title": "composer_api_theme response",
  "description": "What `theme --format json` prints (without the files it wrote), and the plan and the explanation of each theme when asked.",
  "type": "object",
  "required": [
    "key",
    "meter",
    "bars",
    "into",
    "pairing",
    "cadence",
    "tempo",
    "brief",
    "chords",
    "themes"
  ],
  "additionalProperties": false,
  "properties": {
    "key": {
      "type": "string"
    },
    "meter": {
      "type": "string"
    },
    "bars": {
      "type": "integer",
      "minimum": 3,
      "maximum": 16
    },
    "into": {
      "type": "string"
    },
    "pairing": {
      "type": "string"
    },
    "cadence": {
      "type": "string"
    },
    "first_cadence": {
      "type": "string"
    },
    "accompaniment": {
      "type": "string"
    },
    "texture": {
      "type": "string"
    },
    "voicing": {
      "enum": [
        "satb",
        "chorale"
      ]
    },
    "tempo": {
      "type": "object",
      "required": [
        "qpm",
        "from"
      ],
      "properties": {
        "qpm": {
          "type": [
            "number",
            "null"
          ]
        },
        "from": {
          "enum": [
            "option",
            "style",
            "none"
          ]
        }
      },
      "additionalProperties": false
    },
    "brief": {
      "type": "object",
      "required": [
        "tempo",
        "mode",
        "density",
        "without"
      ],
      "additionalProperties": false,
      "properties": {
        "tempo": {
          "type": "object",
          "required": [
            "qpm",
            "from"
          ],
          "properties": {
            "qpm": {
              "type": [
                "number",
                "null"
              ]
            },
            "from": {
              "enum": [
                "option",
                "style",
                "none"
              ]
            }
          },
          "additionalProperties": false
        },
        "mode": {
          "type": "object",
          "required": [
            "mode",
            "from"
          ],
          "properties": {
            "mode": {
              "enum": [
                "major",
                "minor"
              ]
            },
            "from": {
              "enum": [
                "request",
                "style"
              ]
            }
          },
          "additionalProperties": false
        },
        "density": {
          "type": [
            "number",
            "null"
          ]
        },
        "without": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "development": {
          "type": "string"
        }
      }
    },
    "chords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bar",
          "text"
        ],
        "properties": {
          "bar": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/theme"
      }
    },
    "preferences": {
      "$ref": "#/$defs/preferences",
      "description": "The full settings document, present when the request had the member."
    },
    "construction": {
      "type": "object",
      "description": "The construction as the request gave it.",
      "required": [
        "ideas",
        "extensions"
      ],
      "additionalProperties": false,
      "properties": {
        "ideas": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "basic idea",
              "repetition",
              "contrasting idea",
              "consequent basic idea",
              "consequent contrasting idea",
              "fragment 1",
              "fragment 2",
              "cadential",
              "cadential 1",
              "cadential 2"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "extensions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "idea",
              "bars",
              "varied"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "repeat",
                  "stretch",
                  "addition",
                  "evaded"
                ]
              },
              "idea": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bars": {
                "type": "integer",
                "minimum": 0
              },
              "varied": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "theme": {
      "type": "object",
      "required": [
        "seed",
        "structure",
        "construction",
        "chords",
        "developments",
        "slots",
        "score",
        "requested",
        "heard",
        "heard_as_requested",
        "heard_text"
      ],
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "structure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind",
              "start",
              "end"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "form",
                  "section",
                  "phrase",
                  "subphrase",
                  "idea",
                  "motive"
                ]
              },
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "construction": {
          "type": [
            "object",
            "null"
          ],
          "description": "The construction of the theme as built (R-468), null for a theme without one.",
          "required": [
            "halves",
            "ideas",
            "extensions",
            "reason",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "halves": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "ideas": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "idea",
                  "bars",
                  "first_bar"
                ],
                "additionalProperties": false,
                "properties": {
                  "idea": {
                    "enum": [
                      "basic idea",
                      "repetition",
                      "contrasting idea",
                      "consequent basic idea",
                      "consequent contrasting idea",
                      "fragment 1",
                      "fragment 2",
                      "cadential",
                      "cadential 1",
                      "cadential 2"
                    ]
                  },
                  "bars": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "first_bar": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "extensions": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "idea",
                  "bars",
                  "first_bar",
                  "varied"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "repeat",
                      "stretch",
                      "addition",
                      "evaded"
                    ]
                  },
                  "idea": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "bars": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "first_bar": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "varied": {
                    "type": "boolean"
                  }
                }
              }
            },
            "reason": {
              "enum": [
                "given",
                "motive",
                "length"
              ]
            },
            "text": {
              "type": "string"
            }
          }
        },
        "chords": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "bar",
              "beat",
              "chord",
              "function",
              "bass"
            ],
            "properties": {
              "bar": {
                "type": "integer"
              },
              "beat": {
                "type": "integer"
              },
              "chord": {
                "type": "string"
              },
              "function": {
                "type": "string"
              },
              "bass": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "developments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "motive",
              "idea",
              "development",
              "segment",
              "summary",
              "fidelity",
              "minimum",
              "heard",
              "heard_agrees"
            ],
            "properties": {
              "motive": {
                "type": "string"
              },
              "idea": {
                "type": "string"
              },
              "development": {
                "type": "string"
              },
              "segment": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "summary": {
                "type": "string"
              },
              "fidelity": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "minimum": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "heard": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "heard_agrees": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "idea",
              "slot",
              "motive",
              "source",
              "item",
              "chain",
              "connection"
            ],
            "properties": {
              "idea": {
                "type": "string"
              },
              "slot": {
                "enum": [
                  "basic",
                  "contrasting",
                  "continuation",
                  "cadential"
                ]
              },
              "motive": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "motive",
                  "idea",
                  "registry",
                  "operator"
                ]
              },
              "item": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "chain": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "connection": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "score": {
          "type": "object",
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 0
            },
            "denominator": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "requested": {
          "type": "string"
        },
        "heard": {
          "type": [
            "string",
            "null"
          ]
        },
        "heard_as_requested": {
          "type": "boolean"
        },
        "heard_text": {
          "type": "string"
        },
        "style_distance": {
          "type": "object",
          "properties": {
            "harmony": {
              "type": "number"
            },
            "rhythm": {
              "type": "number"
            },
            "melody": {
              "type": "number"
            },
            "form": {
              "type": "number"
            },
            "overall": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "plan": {
          "type": "object",
          "description": "The plan of the theme, with plans: true."
        },
        "explanation": {
          "type": "string",
          "description": "The explanation of the theme, text or JSON text, with explain."
        }
      }
    },
    "preferences": {
      "type": "object",
      "description": "The Composer's settings (docs/preferences.md); every member is optional and its default is the value the Composer used before the document existed. An unknown member is refused with its path.",
      "additionalProperties": false,
      "properties": {
        "melody": {
          "type": "object",
          "description": "The settings of the melody stage (docs/preferences.md).",
          "additionalProperties": false,
          "properties": {
            "range": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "low": {
                  "type": "integer",
                  "minimum": 36,
                  "maximum": 96
                },
                "high": {
                  "type": "integer",
                  "minimum": 48,
                  "maximum": 108,
                  "description": "At least range.low + 12."
                }
              }
            },
            "nct_types": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "passing",
                  "neighbor",
                  "appoggiatura",
                  "suspension",
                  "anticipation"
                ]
              }
            },
            "density": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "climax_position": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "climax_rise": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "climax_slack": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "second_nearest_chord_tone": {
              "type": "string",
              "pattern": "^[0-9]+/[0-9]+$",
              "description": "n/d with 0 <= n <= d and d from 1 to 16."
            },
            "attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "keep": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16,
              "description": "At most attempts."
            },
            "plain_shaping": {
              "type": "boolean"
            },
            "weights": {
              "type": "object",
              "description": "The weight each group of soft rules counts in a melody's score.",
              "additionalProperties": false,
              "properties": {
                "melodic": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "against_bass": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "tendency": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "climax": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "contour": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "ending_reduction": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "waves": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "central_range": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "monotony": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "seam": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            }
          }
        },
        "motif": {
          "type": "object",
          "description": "The settings of the segments motive generator (docs/preferences.md).",
          "additionalProperties": false,
          "properties": {
            "bars": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "one": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "two": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "pickup_one_in": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64,
              "description": "A pickup is drawn one time in this many; 0 never draws one."
            },
            "shapes_one_bar": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "repeat": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "contrast": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "shapes_two_bars": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "repeat": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "contrast": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "repeat_contrast": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "plans_two": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "I-V": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "I-IV": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "I-I": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "plans_three": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "I-V-I": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "I-IV-I": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "features": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "dotted": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "leap": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "repeat": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "leap": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "low": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 12
                },
                "high": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 12,
                  "description": "At least leap.low."
                }
              }
            },
            "rung_moves": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "step": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "skip": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "decorations": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "chord_tone": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "passing": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "neighbor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "appoggiatura": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "escape": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "durations": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "half_beat": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "beat": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "two_beats": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "quarter_beats": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "long_short": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "short_long": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "triplet": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "triplet_two_beats": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "accented_one_in": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64,
              "description": "An eligible note becomes an accented non-chord tone one time in this many; 0 never. Off by default."
            },
            "accented_types": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0. Which accented non-chord tone is placed.",
              "additionalProperties": false,
              "properties": {
                "appoggiatura": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "passing": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "suspension": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "avoid_repeats": {
              "type": "boolean",
              "description": "No repeated note: decorations try the other kinds before a chord tone, and a repeat of a pitch is refused. Off by default."
            },
            "leaps_per_motif": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11,
              "description": "The most intervals of 5 semitones or more in a motive; 11 never rejects."
            },
            "leap_recovery": {
              "type": "boolean",
              "description": "A leap is followed by a move of 1 or 2 semitones the other way. Off by default."
            },
            "pickup_from_accent": {
              "type": "boolean",
              "description": "A pickup is one chord tone below segment a's first note and no longer than it; a motive that opens with an implied upbeat but has no pickup is refused. Off by default."
            },
            "contrast_fidelity_min": {
              "type": "string",
              "pattern": "^[0-9]+/[0-9]+$",
              "description": "n/d with 0 <= n <= d and d from 1 to 1000. The least recognizability of a contrasting segment against segment a; 0/1 never rejects."
            },
            "long_on_weak": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "The two-beat note is this much more likely on a weak beat (its weight times 1 plus this); 0 changes nothing."
            },
            "final_long": {
              "type": "boolean",
              "description": "The last note of the last segment is longer than every other note in it. Off by default."
            },
            "compound_beats": {
              "type": "boolean",
              "description": "In 6/8, 9/8 and 12/8 the beat is the dotted quarter: cells are tiled in beats of three eighths. No effect in any other meter. Off by default."
            },
            "endings": {
              "type": "object",
