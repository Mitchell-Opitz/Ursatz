                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "syncopation_levels": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0. At which level: the short note a half beat (eighth) or a quarter beat (sixteenth).",
