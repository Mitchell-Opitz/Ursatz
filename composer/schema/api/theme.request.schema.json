{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz-Composer/schema/api/theme.request.schema.json",
  "title": "composer_api_theme request",
  "description": "The theme request v2 of docs/theme-request.md with its motives inline, and the options of the theme command as members.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "into",
    "key",
    "meter",
    "motives",
    "slots"
  ],
  "properties": {
    "api_version": {
      "type": "integer"
    },
    "schema": {
      "const": "ursatz-theme-request"
    },
    "schema_version": {
      "const": 2
    },
    "into": {
      "enum": [
        "sentence",
        "period",
        "hybrid"
      ]
    },
    "hybrid": {
      "type": [
        "string",
        "null"
      ]
    },
    "key": {
      "type": "string"
    },
    "material": {
      "type": "string",
      "description": "A material: a K1 id, name, key word or alias (omt.material.major, \"major\", \"minor\"), or \"style\" for the style's. The Composer writes keys in major and natural minor. With a key that is a tonic alone it gives the mode of the key. The old member \"mode\" is read as before; give material or mode, not both."
    },
    "mode": {
      "enum": [
        "major",
        "minor",
        "style"
      ],
      "description": "The old name of material, read as before (major or minor, style). Give material or mode, not both."
    },
    "meter": {
      "type": "string"
    },
    "bars": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 3,
      "maximum": 16,
      "description": "3 to 16 bars; 4 and 8 need no construction, any other length gets one (R-469)."
    },
    "construction": {
      "type": [
        "object",
        "null"
      ],
      "description": "The bars of each idea of the theme and its extensions (R-468); null for none, then a theme of 4 or 8 bars is as it always was and any other length gets a construction chosen from the motif or the length (R-469).",
      "required": [
        "ideas"
      ],
      "additionalProperties": false,
      "properties": {
        "ideas": {
          "type": "object",
          "description": "Bars of each idea by name; an idea the pairing does not have is left out or 0.",
          "propertyNames": {
            "enum": [
              "basic idea",
              "repetition",
              "contrasting idea",
              "consequent basic idea",
              "consequent contrasting idea",
              "fragment 1",
              "fragment 2",
              "cadential",
              "cadential 1",
              "cadential 2"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16
          }
        },
        "extensions": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "repeat",
                  "stretch",
                  "addition",
                  "evaded"
                ]
              },
              "idea": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Required for a repeat and a stretch."
              },
              "bars": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 4
              },
              "varied": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "cadence": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_cadence": {
      "type": [
        "string",
        "null"
      ]
    },
    "development": {
      "type": [
        "string",
        "null"
      ]
    },
    "motives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/motive"
      }
    },
    "slots": {
      "type": "object",
      "required": [
        "basic"
      ],
      "properties": {
        "basic": {
          "type": "string"
        },
        "contrasting": {
          "type": [
            "string",
            "null"
          ]
        },
        "continuation": {
          "type": [
            "string",
            "null"
          ]
        },
        "cadential": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ideas": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "chords": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "bar",
          "text"
        ],
        "properties": {
          "bar": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "accompaniment": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "enum": [
            "any",
            "block",
            "arpeggiated",
            "alberti",
            "oom-pah",
            "motive"
          ]
        },
        "motive": {
          "$ref": "#/$defs/motive"
        }
      }
    },
    "voicing": {
      "enum": [
        "satb",
        "chorale",
        null
      ]
    },
    "style": {
      "type": [
        "string",
        "null"
      ],
      "description": "A style model file path."
    },
    "style_weight": {
      "type": [
        "string",
        "null"
      ]
    },
    "without": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "blend": {
      "type": [
        "string",
        "null"
      ],
      "description": "A second style model file path, blended with style."
    },
    "blend_weight": {
      "type": [
        "string",
        "null"
      ]
    },
    "blend_weights": {
      "type": [
        "string",
        "null"
      ]
    },
    "tempo": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "seed": {
      "type": [
        "integer",
        "string"
      ]
    },
    "suggest": {
      "type": [
        "integer",
        "string"
      ]
    },
    "check": {
      "type": "boolean"
    },
    "midi": {
      "type": "boolean"
    },
    "musicxml": {
      "type": "boolean"
    },
    "plain_midi": {
      "type": "boolean"
    },
    "plans": {
      "type": "boolean"
    },
    "layers": {
      "type": "boolean",
      "description": "Also return the realization and the reading of the first result as \"realization\" and \"reading\"."
    },
    "explain": {
      "enum": [
        "text",
        "json"
      ]
    },
    "preferences": {
      "$ref": "https://github.com/Mitchell-Opitz/Ursatz-Composer/schema/api/preferences.schema.json",
      "description": "The settings; the melody group and the development group apply, the motif group is accepted and has no effect (the motives come from the request)."
    }
  },
  "$defs": {
    "motive": {
      "type": "object",
      "required": [
        "id",
        "degrees"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "form": {
          "enum": [
            "full",
            null
          ]
        },
        "degrees": {
          "type": "string",
          "description": "A degree list in the key and mode of the request: 1:q b3:e 5:e 1':h"
        },
        "pickup": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "harmony": {
          "type": [
            "string",
            "null"
          ]
        },
        "features": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "label",
              "first",
              "last"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "first": {
                "type": "integer",
                "minimum": 0
              },
              "last": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "role": {
          "enum": [
            "melodic",
            "accompaniment",
            null
          ]
        },
        "tone_overrides": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "description": "A motive carries its content: a member \"path\" or \"file\" is refused (path /motives/<n>/path)."
    }
  },
  "anyOf": [
    {
      "required": [
        "material"
      ]
    },
    {
      "required": [
        "mode"
      ]
    }
  ],
  "not": {
    "required": [
      "material",
      "mode"
    ]
  }
}
