{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz-Composer/schema/api/theme.request.schema.json",
  "title": "composer_api_theme request",
  "description": "The theme request v2 of docs/theme-request.md with its motives inline, and the options of the theme command as members.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "into",
    "key",
    "mode",
    "meter",
    "motives",
    "slots"
  ],
  "properties": {
    "api_version": {
      "type": "integer"
    },
    "schema": {
      "const": "ursatz-theme-request"
    },
    "schema_version": {
      "const": 2
    },
    "into": {
      "enum": [
        "sentence",
        "period",
        "hybrid"
      ]
    },
    "hybrid": {
      "type": [
        "string",
        "null"
      ]
    },
    "key": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "major",
        "minor",
        "style"
      ]
    },
    "meter": {
      "type": "string"
    },
    "bars": {
      "enum": [
        4,
        8,
        null
      ]
    },
    "cadence": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_cadence": {
      "type": [
        "string",
        "null"
      ]
    },
    "development": {
      "type": [
        "string",
        "null"
      ]
    },
    "motives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/motive"
      }
    },
    "slots": {
      "type": "object",
      "required": [
        "basic"
      ],
      "properties": {
        "basic": {
          "type": "string"
        },
        "contrasting": {
          "type": [
            "string",
            "null"
          ]
        },
        "continuation": {
          "type": [
            "string",
            "null"
          ]
        },
        "cadential": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ideas": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "chords": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "bar",
          "text"
        ],
        "properties": {
          "bar": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "accompaniment": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "enum": [
            "any",
            "block",
            "arpeggiated",
            "alberti",
            "oom-pah",
            "motive"
          ]
        },
        "motive": {
          "$ref": "#/$defs/motive"
        }
      }
    },
    "voicing": {
      "enum": [
        "satb",
        "chorale",
        null
      ]
    },
    "style": {
      "type": [
        "string",
        "null"
      ],
      "description": "A style model file path."
    },
    "style_weight": {
      "type": [
        "string",
        "null"
      ]
    },
    "without": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "blend": {
      "type": [
        "string",
        "null"
      ],
      "description": "A second style model file path, blended with style."
    },
    "blend_weight": {
      "type": [
        "string",
        "null"
      ]
    },
    "blend_weights": {
      "type": [
        "string",
        "null"
      ]
    },
    "tempo": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "seed": {
      "type": [
        "integer",
        "string"
      ]
    },
    "suggest": {
      "type": [
        "integer",
        "string"
      ]
    },
    "check": {
      "type": "boolean"
    },
    "midi": {
      "type": "boolean"
    },
    "musicxml": {
      "type": "boolean"
    },
    "plain_midi": {
      "type": "boolean"
    },
    "plans": {
      "type": "boolean"
    },
    "explain": {
      "enum": [
        "text",
        "json"
      ]
    }
  },
  "$defs": {
    "motive": {
      "type": "object",
      "required": [
        "id",
        "degrees"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "form": {
          "enum": [
            "full",
            null
          ]
        },
        "degrees": {
          "type": "string",
          "description": "A degree list in the key and mode of the request: 1:q b3:e 5:e 1':h"
        },
        "pickup": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "harmony": {
          "type": [
            "string",
            "null"
          ]
        },
        "features": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "label",
              "first",
              "last"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "first": {
                "type": "integer",
                "minimum": 0
              },
              "last": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "role": {
          "enum": [
            "melodic",
            "accompaniment",
            null
          ]
        },
        "tone_overrides": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "description": "A motive carries its content: a member \"path\" or \"file\" is refused (path /motives/<n>/path)."
    }
  }
}
