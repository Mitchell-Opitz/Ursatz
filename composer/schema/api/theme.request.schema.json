              "type": "integer",
              "minimum": 0,
              "maximum": 11,
              "description": "The most skips (intervals of 3 or 4 semitones) in a motif; 11 never rejects, the default."
            },
            "plan": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "description": "A given chord plan: Roman numerals I to VII in any case, an optional o or degree sign, an optional place @bar or @bar:beat (bar 1 or 2, beat 1 to 12). Either no chord has a place (at most 3 chords) or every chord after the first has one, rising. Absent by default: the plan is drawn.",
              "items": {
                "type": "string",
                "pattern": "^(?i:VII|VI|V|IV|III|II|I)(o|°)?(@[12](:([1-9]|1[0-2]))?)?$"
              }
            }
          }
