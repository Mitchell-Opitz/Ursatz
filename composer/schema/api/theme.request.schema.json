{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz/composer/schema/api/theme.request.schema.json",
  "title": "composer_api_theme request",
  "description": "The theme request v2 of docs/theme-request.md with its motives inline, and the options of the theme command as members. With a blueprint (blueprints.md) the motives and the slots are optional, and chords, accompaniment and ideas are refused.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "into",
    "key",
    "meter"
  ],
  "properties": {
    "api_version": {
      "type": "integer"
    },
    "schema": {
      "const": "ursatz-theme-request"
    },
    "schema_version": {
      "const": 2
    },
    "into": {
      "enum": [
        "sentence",
        "period",
        "hybrid"
      ]
    },
    "hybrid": {
      "type": [
        "string",
        "null"
      ]
    },
    "key": {
      "type": "string"
    },
    "material": {
      "type": "string",
      "description": "A material: a K1 id, name, key word or alias (omt.material.major, \"major\", \"minor\"), or \"style\" for the style's. The Composer writes keys in major, natural minor and the church modes (\"dorian\", \"lydian\", \"mixolydian\", \"phrygian\", \"locrian\"; see modes.md). With a key that is a tonic alone it gives the mode of the key. The old member \"mode\" is read as before; give material or mode, not both."
    },
    "mode": {
      "enum": [
        "major",
        "minor",
        "style"
      ],
      "description": "The old name of material, read as before (major or minor, style). Give material or mode, not both."
    },
    "meter": {
      "type": "string"
    },
    "bars": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 3,
      "maximum": 16,
      "description": "3 to 16 bars; 4 and 8 need no construction, any other length gets one (R-469)."
    },
    "construction": {
      "type": [
        "object",
        "null"
      ],
      "description": "The bars of each idea of the theme and its extensions (R-468); null for none, then a theme of 4 or 8 bars is as it always was and any other length gets a construction chosen from the motif or the length (R-469).",
      "required": [
        "ideas"
      ],
      "additionalProperties": false,
      "properties": {
        "ideas": {
          "type": "object",
          "description": "Bars of each idea by name; an idea the pairing does not have is left out or 0.",
          "propertyNames": {
            "enum": [
              "basic idea",
              "repetition",
              "contrasting idea",
              "consequent basic idea",
              "consequent contrasting idea",
              "fragment 1",
              "fragment 2",
              "cadential",
              "cadential 1",
              "cadential 2"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16
          }
        },
        "extensions": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "repeat",
                  "stretch",
                  "addition",
                  "evaded"
                ]
              },
              "idea": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Required for a repeat and a stretch."
              },
              "bars": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 4
              },
              "varied": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "cadence": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_cadence": {
      "type": [
        "string",
        "null"
      ]
    },
    "development": {
      "type": [
        "string",
        "null"
      ]
    },
    "motives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/motive"
      }
    },
    "slots": {
      "type": "object",
      "required": [
        "basic"
      ],
      "properties": {
        "basic": {
          "type": "string"
        },
        "contrasting": {
          "type": [
            "string",
            "null"
          ]
        },
        "continuation": {
          "type": [
            "string",
            "null"
          ]
        },
        "cadential": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ideas": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "chords": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "bar",
          "text"
        ],
        "properties": {
          "bar": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "accompaniment": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "anyOf": [
            {
              "enum": [
                "any",
                "block",
                "arpeggiated",
                "alberti",
                "oom-pah",
                "motive"
              ]
            },
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9.-]*$",
              "maxLength": 63,
              "description": "The id of a K11 accompaniment entry, for example michelle.pattern.arpeggio-wave."
            }
          ]
        },
        "motive": {
          "$ref": "#/$defs/motive"
        }
      }
    },
    "voicing": {
      "enum": [
        "satb",
        "chorale",
        null
      ]
    },
    "style": {
      "type": [
        "string",
        "null"
      ],
      "description": "A style model file path."
    },
    "style_weight": {
      "type": [
        "string",
        "null"
      ]
    },
    "without": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "blend": {
      "type": [
        "string",
        "null"
      ],
      "description": "A second style model file path, blended with style."
    },
    "blend_weight": {
      "type": [
        "string",
        "null"
      ]
    },
    "blend_weights": {
      "type": [
        "string",
        "null"
      ]
    },
    "tempo": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "seed": {
      "type": [
        "integer",
        "string"
      ]
    },
    "suggest": {
      "type": [
        "integer",
        "string"
      ]
    },
    "check": {
      "type": "boolean"
    },
    "midi": {
      "type": "boolean"
    },
    "musicxml": {
      "type": "boolean"
    },
    "plain_midi": {
      "type": "boolean"
    },
    "plans": {
      "type": "boolean"
    },
    "layers": {
      "type": "boolean",
      "description": "Also return the realization and the reading of the first result as \"realization\" and \"reading\"."
    },
    "explain": {
      "enum": [
        "text",
        "json"
      ]
    },
    "preferences": {
      "$ref": "https://github.com/Mitchell-Opitz/Ursatz/composer/schema/api/preferences.schema.json",
      "description": "The settings; the melody group and the development group apply, the motif group shapes the rhythms and new material a theme draws, not its motives (they come from the request)."
    },
    "blueprint": {
      "type": "object",
      "description": "The theme as a blueprint (R-743, blueprints.md): a bar object for each bar of the theme, the climax and the accompaniment; what a bar leaves out is composed.",
      "required": [
        "bars"
      ],
      "additionalProperties": false,
      "properties": {
        "bars": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "description": "Exactly the theme's bars, the first bar first.",
          "items": {
            "$ref": "#/$defs/blueprintBar"
          }
        },
        "climax": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "bar",
            "at",
            "pitch"
          ],
          "additionalProperties": false,
          "description": "The theme's one highest note: its bar (from 0), its onset in beats of the beat unit and its pitch.",
          "properties": {
            "bar": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "at": {
              "$ref": "#/$defs/blueprintAt"
            },
            "pitch": {
              "type": "string"
            }
          }
        },
        "accompaniment": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "pattern"
          ],
          "additionalProperties": false,
          "description": "The accompaniment, as the request's accompaniment member reads it (no motive pattern).",
          "properties": {
            "pattern": {
              "anyOf": [
                {
                  "enum": [
                    "any",
                    "block",
                    "arpeggiated",
                    "alberti",
                    "oom-pah"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9.-]*$",
                  "maxLength": 63,
                  "description": "The id of a K11 accompaniment entry."
                }
              ]
            },
            "voicing": {
              "type": [
                "string",
                "null"
              ],
              "description": "The id of a K3 voicing, with the pattern block."
            }
          }
        }
      }
    },
    "preset": {
      "type": [
        "string",
        "null"
      ],
      "description": "The name of a preset (R-754): settings of her listening, built in, which `preferences` apply over (the vocabulary's presets). Its accompaniment pattern is the theme's when the request gives none."
    }
  },
  "$defs": {
    "motive": {
      "type": "object",
      "required": [
        "id",
        "degrees"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "form": {
          "enum": [
            "full",
            null
          ]
        },
        "degrees": {
          "type": "string",
          "description": "A degree list in the key and mode of the request: 1:q b3:e 5:e 1':h"
        },
        "pickup": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "harmony": {
          "type": [
            "string",
            "null"
          ]
        },
        "features": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "label",
              "first",
              "last"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "first": {
                "type": "integer",
                "minimum": 0
              },
              "last": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "role": {
          "enum": [
            "melodic",
            "accompaniment",
            null
          ]
        },
        "tone_overrides": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "description": "A motive carries its content: a member \"path\" or \"file\" is refused (path /motives/<n>/path)."
    },
    "blueprintAt": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^[0-9]+(/[1-9][0-9]*)?$",
      "minimum": 0,
      "description": "An onset from the bar start in beats of the beat unit, as a chord onset writes it: \"0\", \"2\", \"3/2\"."
    },
    "blueprintBar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chords": {
          "type": "string",
          "description": "The chord text of the bar (R-744): \"I\", \"II6 V7@2\"."
        },
        "melody": {
          "type": "string",
          "description": "A note list of one bar (note-list syntax: \"D5:q. C5:e r:e\"), rests allowed, ending on a rest if it likes. Given melody; refused with rhythm, job, anchors and events."
        },
        "rhythm": {
          "type": "string",
          "description": "A rhythm text of one bar (\"x:q. x:e x:h\", rests r, ties ~); refused with melody and job."
        },
        "job": {
          "type": "string",
          "description": "A K11 rhythm job (motif, variant, contrast, running, long, syncopated, liquidation, cadence) or the id of a K11 rhythm entry; refused with melody and rhythm."
        },
        "anchors": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "at",
              "pitch"
            ],
            "additionalProperties": false,
            "properties": {
              "at": {
                "$ref": "#/$defs/blueprintAt"
              },
              "pitch": {
                "type": "string"
              }
            }
          }
        },
        "events": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "at",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "at": {
                "$ref": "#/$defs/blueprintAt"
              },
              "type": {
                "enum": [
                  "appoggiatura",
                  "suspension",
                  "passing",
                  "neighbor",
                  "escape",
                  "anticipation",
                  "retardation"
                ]
              }
            }
          }
        },
        "bass": {
          "type": "string",
          "description": "A note list of one bar (note-list syntax: \"D5:q. C5:e r:e\"), rests allowed, ending on a rest if it likes. Given in every bar or none; a rest only where the melody is given."
        },
        "inner": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          },
          "description": "The inner voices, one note list each (voice 1 first), as many in every bar."
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "material"
      ]
    },
    {
      "required": [
        "mode"
      ]
    }
  ],
  "not": {
    "required": [
      "material",
      "mode"
    ]
  },
  "if": {
    "not": {
      "required": [
        "blueprint"
      ]
    }
  },
  "then": {
    "required": [
      "motives",
      "slots"
    ]
  }
}
