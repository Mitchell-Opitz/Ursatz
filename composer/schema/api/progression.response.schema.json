{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz/composer/schema/api/progression.response.schema.json",
  "title": "composer_api_progression response",
  "description": "What `progression --format json` prints, without the files; or the lists of names.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "key",
        "meter",
        "bars",
        "cadence",
        "seed"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "meter": {
          "type": "string"
        },
        "bars": {
          "type": "integer"
        },
        "cadence": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "heard",
              "chords"
            ],
            "properties": {
              "heard": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "chords": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "bar",
                    "beat",
                    "chord",
                    "function",
                    "bass"
                  ],
                  "properties": {
                    "bar": {
                      "type": "integer"
                    },
                    "beat": {
                      "type": "integer"
                    },
                    "chord": {
                      "type": "string"
                    },
                    "function": {
                      "type": "string"
                    },
                    "bass": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "plan": {
                "type": "object"
              },
              "musicxml": {
                "type": "string"
              },
              "measures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "bar",
                    "tension",
                    "brightness"
                  ],
                  "properties": {
                    "bar": {
                      "type": "integer"
                    },
                    "tension": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "brightness": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "harmony": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "material",
                  "meter",
                  "bars",
                  "chords",
                  "stages"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "material": {
                    "type": "string"
                  },
                  "with": {
                    "type": "string"
                  },
                  "meter": {
                    "type": "string"
                  },
                  "bars": {
                    "type": "integer"
                  },
                  "chords": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "bar",
                        "text"
                      ],
                      "properties": {
                        "bar": {
                          "type": "integer"
                        },
                        "text": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "stages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "chord",
                        "units"
                      ],
                      "properties": {
                        "chord": {
                          "type": "string"
                        },
                        "units": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "heard": {
          "type": [
            "string",
            "null"
          ]
        },
        "chords": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "bar",
              "beat",
              "chord",
              "function",
              "bass"
            ],
            "properties": {
              "bar": {
                "type": "integer"
              },
              "beat": {
                "type": "integer"
              },
              "chord": {
                "type": "string"
              },
              "function": {
                "type": "string"
              },
              "bass": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "plan": {
          "type": "object"
        },
        "musicxml": {
          "type": "string"
        },
        "realization": {
          "$ref": "https://github.com/Mitchell-Opitz/Ursatz/library/realization/schema/realization.v1.schema.json",
          "description": "The work of the first progression as its MIDI and MusicXML are written from it, with layers: true."
        },
        "reading": {
          "$ref": "https://github.com/Mitchell-Opitz/Ursatz/library/reading/schema/reading.v1.schema.json",
          "description": "The Composer's hearing of the first progression over that realization, with layers: true."
        },
        "measures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bar",
              "tension",
              "brightness"
            ],
            "properties": {
              "bar": {
                "type": "integer"
              },
              "tension": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "brightness": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "harmony": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "material",
            "meter",
            "bars",
            "chords",
            "stages"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "material": {
              "type": "string"
            },
            "with": {
              "type": "string"
            },
            "meter": {
              "type": "string"
            },
            "bars": {
              "type": "integer"
            },
            "chords": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "bar",
                  "text"
                ],
                "properties": {
                  "bar": {
                    "type": "integer"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            },
            "stages": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "chord",
                  "units"
                ],
                "properties": {
                  "chord": {
                    "type": "string"
                  },
                  "units": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "heard",
            "chords"
          ]
        },
        {
          "required": [
            "alternatives"
          ]
        }
      ]
    },
    {
      "type": "object",
      "required": [
        "schemas",
        "sequences"
      ],
      "properties": {
        "schemas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "function",
              "materials"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "function": {
                "type": "string"
              },
              "materials": {
                "type": "array",
                "items": {
                  "enum": [
                    "omt.material.major",
                    "omt.material.natural-minor"
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        },
        "sequences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "progression_schemas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "loop",
              "materials"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "loop": {
                "type": "boolean"
              },
              "materials": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
