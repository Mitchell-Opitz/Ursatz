{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz-Composer/schema/api/progression.response.schema.json",
  "title": "composer_api_progression response",
  "description": "What `progression --format json` prints, without the files; or the lists of names.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "key",
        "meter",
        "bars",
        "cadence",
        "seed"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "meter": {
          "type": "string"
        },
        "bars": {
          "type": "integer"
        },
        "cadence": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "heard",
              "chords"
            ],
            "properties": {
              "heard": {
                "type": "string"
              },
              "chords": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "bar",
                    "beat",
                    "chord",
                    "function",
                    "bass"
                  ],
                  "properties": {
                    "bar": {
                      "type": "integer"
                    },
                    "beat": {
                      "type": "integer"
                    },
                    "chord": {
                      "type": "string"
                    },
                    "function": {
                      "type": "string"
                    },
                    "bass": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "plan": {
                "type": "object"
              },
              "musicxml": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "heard": {
          "type": "string"
        },
        "chords": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "bar",
              "beat",
              "chord",
              "function",
              "bass"
            ],
            "properties": {
              "bar": {
                "type": "integer"
              },
              "beat": {
                "type": "integer"
              },
              "chord": {
                "type": "string"
              },
              "function": {
                "type": "string"
              },
              "bass": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "plan": {
          "type": "object"
        },
        "musicxml": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "heard",
            "chords"
          ]
        },
        {
          "required": [
            "alternatives"
          ]
        }
      ]
    },
    {
      "type": "object",
      "required": [
        "schemas",
        "sequences"
      ],
      "properties": {
        "schemas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "function",
              "modes"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "function": {
                "type": "string"
              },
              "modes": {
                "type": "array",
                "items": {
                  "enum": [
                    "major",
                    "minor"
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        },
        "sequences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
