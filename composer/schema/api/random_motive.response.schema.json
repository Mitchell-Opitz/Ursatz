{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz-Composer/schema/api/random_motive.response.schema.json",
  "title": "composer_api_random_motive response",
  "description": "What `random-motive --json` prints, and `drawn` when the mode or the meter was drawn from the seed.",
  "type": "object",
  "required": [
    "seed",
    "motives"
  ],
  "additionalProperties": false,
  "properties": {
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "motives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "motive",
          "analysis"
        ],
        "properties": {
          "motive": {
            "type": "object"
          },
          "analysis": {
            "type": "object"
          }
        }
      }
    },
    "drawn": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "major",
            "minor"
          ]
        },
        "meter": {
          "enum": [
            "4/4",
            "3/4",
            "2/4",
            "6/8"
          ]
        }
      }
    },
    "preferences": {
      "$ref": "#/$defs/preferences",
      "description": "The full settings document, present when the request had the member."
    }
  },
  "$defs": {
    "preferences": {
      "type": "object",
      "description": "The Composer's settings (docs/preferences.md); every member is optional and its default is the value the Composer used before the document existed. An unknown member is refused with its path.",
      "additionalProperties": false,
      "properties": {
        "melody": {
          "type": "object",
          "description": "The settings of the melody stage (docs/preferences.md).",
          "additionalProperties": false,
          "properties": {
            "range": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "low": {
                  "type": "integer",
                  "minimum": 36,
                  "maximum": 96
                },
                "high": {
                  "type": "integer",
                  "minimum": 48,
                  "maximum": 108,
                  "description": "At least range.low + 12."
                }
              }
            },
            "nct_types": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "passing",
                  "neighbor",
                  "appoggiatura",
                  "suspension",
                  "anticipation"
                ]
              }
            },
            "density": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "climax_position": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "climax_rise": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "climax_slack": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "second_nearest_chord_tone": {
              "type": "string",
              "pattern": "^[0-9]+/[0-9]+$",
              "description": "n/d with 0 <= n <= d and d from 1 to 16."
            },
            "attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "keep": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16,
              "description": "At most attempts."
            },
            "plain_shaping": {
              "type": "boolean"
            },
            "weights": {
              "type": "object",
              "description": "The weight each group of soft rules counts in a melody's score.",
              "additionalProperties": false,
              "properties": {
                "melodic": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "against_bass": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "tendency": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "climax": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "contour": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "ending_reduction": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "waves": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "central_range": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "monotony": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "seam": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            }
          }
        },
        "motif": {
          "type": "object",
          "description": "The settings of the segments motive generator (docs/preferences.md).",
          "additionalProperties": false,
          "properties": {
            "bars": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "one": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "two": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "pickup_one_in": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64,
              "description": "A pickup is drawn one time in this many; 0 never draws one."
            },
            "shapes_one_bar": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "repeat": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "contrast": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "shapes_two_bars": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "repeat": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "contrast": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "repeat_contrast": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "plans_two": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "I-V": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "I-IV": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "I-I": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "plans_three": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "I-V-I": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "I-IV-I": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "features": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "dotted": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "leap": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "repeat": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "leap": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "low": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 12
                },
                "high": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 12,
                  "description": "At least leap.low."
                }
              }
            },
            "rung_moves": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "step": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "skip": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "decorations": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "chord_tone": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "passing": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "neighbor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "appoggiatura": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "escape": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "durations": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0.",
              "additionalProperties": false,
              "properties": {
                "half_beat": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "beat": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "two_beats": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "accented_one_in": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64,
              "description": "An eligible note becomes an accented non-chord tone one time in this many; 0 never. Off by default."
            },
            "accented_types": {
              "type": "object",
              "description": "Whole-number weights 0 to 20; the sum of the entries is above 0. Which accented non-chord tone is placed.",
              "additionalProperties": false,
              "properties": {
                "appoggiatura": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "passing": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "suspension": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              }
            },
            "avoid_repeats": {
              "type": "boolean",
              "description": "No repeated note: decorations try the other kinds before a chord tone, and a repeat of a pitch is refused. Off by default."
            },
            "leaps_per_motif": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11,
              "description": "The most intervals of 5 semitones or more in a motive; 11 never rejects."
            },
            "leap_recovery": {
              "type": "boolean",
              "description": "A leap is followed by a move of 1 or 2 semitones the other way. Off by default."
            },
            "pickup_from_accent": {
              "type": "boolean",
              "description": "A pickup is one chord tone below segment a's first note and no longer than it; a motive that opens with an implied upbeat but has no pickup is refused. Off by default."
            },
            "contrast_fidelity_min": {
              "type": "string",
              "pattern": "^[0-9]+/[0-9]+$",
              "description": "n/d with 0 <= n <= d and d from 1 to 1000. The least recognizability of a contrasting segment against segment a; 0/1 never rejects."
            },
            "long_on_weak": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "The two-beat note is this much more likely on a weak beat (its weight times 1 plus this); 0 changes nothing."
            },
            "final_long": {
              "type": "boolean",
              "description": "The last note of the last segment is longer than every other note in it. Off by default."
            }
          }
        },
        "development": {
          "type": "object",
          "description": "The settings of the theme's development (docs/preferences.md).",
          "additionalProperties": false,
          "properties": {
            "fidelity_minimum": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "melody": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "presentation": {
                      "type": "string",
                      "pattern": "^[0-9]+/[0-9]+$",
                      "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                    },
                    "continuation": {
                      "type": "string",
                      "pattern": "^[0-9]+/[0-9]+$",
                      "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                    },
                    "cadential": {
                      "type": "string",
                      "pattern": "^[0-9]+/[0-9]+$",
                      "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                    }
                  }
                },
                "balanced": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "presentation": {
                      "type": "string",
                      "pattern": "^[0-9]+/[0-9]+$",
                      "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                    },
                    "continuation": {
                      "type": "string",
                      "pattern": "^[0-9]+/[0-9]+$",
                      "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                    },
                    "cadential": {
                      "type": "string",
                      "pattern": "^[0-9]+/[0-9]+$",
                      "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                    }
                  }
                },
                "theme": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "presentation": {
                      "type": "string",
                      "pattern": "^[0-9]+/[0-9]+$",
                      "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                    },
                    "continuation": {
                      "type": "string",
                      "pattern": "^[0-9]+/[0-9]+$",
                      "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                    },
                    "cadential": {
                      "type": "string",
                      "pattern": "^[0-9]+/[0-9]+$",
                      "description": "n/d with 0 <= n <= d and d from 1 to 1000."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
