{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz-Composer/schema/form.v1.schema.json",
  "title": "Ursatz Composer form, version 1",
  "description": "A form as a document (R-416): its sections at each size it comes in, the keys a piece may move to, the cadences, the returns and the checks that apply. See docs/forms.md.",
  "type": "object",
  "required": ["schema", "version", "name", "label"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "ursatz-form" },
    "version": { "const": 1 },
    "name": { "$ref": "#/$defs/name" },
    "label": { "type": "string", "minLength": 1, "maxLength": 63 },
    "plan_name": { "$ref": "#/$defs/name" },
    "closing": { "type": "boolean", "default": false },
    "modulates": { "type": "boolean", "default": false },
    "accompaniment": { "enum": ["optional", "required"], "default": "optional" },
    "regions": {
      "type": "array",
      "maxItems": 4,
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "major", "minor"],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "#/$defs/name", "not": { "const": "home" } },
          "major": { "$ref": "#/$defs/degrees" },
          "minor": { "$ref": "#/$defs/degrees" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": { "enum": ["sections", "returns", "keys", "cadences", "seam"] },
      "uniqueItems": true
    },
    "meters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "enum": ["2/4", "3/4", "4/4", "6/8"] },
      "uniqueItems": true
    },
    "tempo": { "type": "integer", "minimum": 30, "maximum": 300 },
    "repeats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "A compound form (R-485): each part is a piece of a built-in form with sizes, composed on its own and performed in order; its sizes have bars and no sections.",
      "items": { "$ref": "#/$defs/part" }
    },
    "sizes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/size" }
    },
    "sections": { "const": "request" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["intro", "body", "turnaround", "ending"] },
      "description": "A form whose sections the request gives: the roles a section may have, in the order intro, body, turnaround, ending, and including body (until P45)."
    },
    "loop": {
      "type": "object",
      "required": ["roles"],
      "additionalProperties": false,
      "properties": {
        "roles": { "$ref": "#/$defs/partRoles", "description": "The roles that are the loop: its end is held for the seam stage and a seam bar follows it; the ending version replaces the turnaround with the ending. Each is one of the form's roles." }
      }
    },
    "cadences": {
      "type": "object",
      "required": ["default"],
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/$defs/cadenceName", "description": "The cadence of a section the request gives none." },
        "last": {
          "type": "array",
          "maxItems": 4,
          "description": "Applied in order: the last section whose role is in roles ends in cadence.",
          "items": {
            "type": "object",
            "required": ["roles", "cadence"],
            "additionalProperties": false,
            "properties": {
              "roles": { "$ref": "#/$defs/partRoles" },
              "cadence": { "$ref": "#/$defs/cadenceName" }
            }
          }
        }
      }
    },
    "default_ending": {
      "type": "object",
      "required": ["id", "letter", "role", "bars", "cadence"],
      "additionalProperties": false,
      "description": "The section a request with no ending gets.",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 15 },
        "letter": { "type": "string", "minLength": 1, "maxLength": 3 },
        "role": { "const": "ending" },
        "bars": { "type": "integer", "minimum": 1, "maximum": 64 },
        "cadence": { "$ref": "#/$defs/cadenceName" }
      }
    }
  },
  "oneOf": [
    {
      "required": ["sizes"],
      "not": { "anyOf": [{ "required": ["sections"] }, { "required": ["roles"] }, { "required": ["loop"] }, { "required": ["cadences"] }, { "required": ["default_ending"] }, { "required": ["parts"] }] },
      "properties": { "sizes": { "items": { "required": ["sections"] } } }
    },
    {
      "required": ["sizes", "parts"],
      "not": { "anyOf": [{ "required": ["sections"] }, { "required": ["roles"] }, { "required": ["loop"] }, { "required": ["cadences"] }, { "required": ["default_ending"] }, { "required": ["repeats"] }] },
      "properties": { "sizes": { "items": { "not": { "anyOf": [{ "required": ["sections"] }, { "required": ["count"] }] } } } }
    },
    { "required": ["sections", "roles", "loop", "cadences"], "not": { "required": ["sizes"] } }
  ],
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9-]{1,31}$" },
    "cadenceName": { "type": "string", "description": "A name of the standard-harmony cadence vocabulary whose core is a PAC, an IAC or an HC." },
    "partRoles": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "enum": ["intro", "body", "turnaround", "ending"] } },
    "degrees": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "integer", "minimum": 1, "maximum": 7 }
    },
    "part": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["form"], "not": { "required": ["again"] } },
        { "required": ["again"], "not": { "anyOf": [{ "required": ["form"] }, { "required": ["key"] }, { "required": ["motive"] }, { "required": ["bars"] }] } }
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 31, "description": "Unique among the parts; the prefix of its sections' names after the first part." },
        "form": { "$ref": "#/$defs/name", "description": "A built-in form with sizes that is not itself compound, with a size of each of the form's bars." },
        "key": { "type": "string", "default": "home", "description": "\"home\" or the name of a region of the form: the key the part is in." },
        "motive": { "enum": ["piece", "new"], "default": "piece", "description": "The piece's motive, or one of its own, invented." },
        "again": { "type": "string", "description": "The name of an earlier part that is not an again part: this part performs it once more." },
        "repeats": { "type": "boolean", "description": "Whether the part's repeats are written out; true, and false for an again part." },
        "bars": { "type": "integer", "minimum": 1, "description": "The size of the part's form it is composed at, in place of the compound size's bars; the form has a size of these bars. Not with again." }
      }
    },
    "size": {
      "type": "object",
      "required": ["bars"],
      "additionalProperties": false,
      "properties": {
        "bars": { "type": "integer", "minimum": 1, "description": "The sum of its sections' bars." },
        "count": { "type": "integer", "minimum": 1, "description": "The variations or layers the size has." },
        "default": { "type": "boolean", "description": "The size a request gets when it asks for none; exactly one size has it." },
        "sections": { "type": "array", "minItems": 1, "maxItems": 9, "items": { "$ref": "#/$defs/section" } }
      }
    },
    "section": {
      "type": "object",
      "required": ["name", "letter", "role", "beginning", "ending", "cadence"],
      "additionalProperties": false,
      "oneOf": [{ "required": ["bars"] }, { "required": ["beats"] }],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 31, "description": "Unique in its size." },
        "letter": { "type": "string", "minLength": 1, "maxLength": 3 },
        "role": { "enum": ["theme", "contrast", "return", "variation", "layer", "intro", "body", "turnaround", "ending"] },
        "bars": { "type": "integer", "minimum": 1 },
        "beats": { "type": "integer", "minimum": 1 },
        "beginning": { "enum": ["presentation", "antecedent", "compound_basic_idea"] },
        "ending": { "enum": ["continuation", "consequent", "cadential"] },
        "cadence": { "type": "string", "description": "A name of the standard-harmony cadence vocabulary whose core is a PAC, an IAC or an HC." },
        "closed": { "type": "boolean", "default": false },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": { "type": "string", "description": "\"home\" or a region's name." },
            "end": { "type": "string", "description": "\"home\" or a region's name." }
          }
        },
        "motive": { "type": "string", "description": "How the section's motive is made from m0, as motive_relation_step_text writes it." },
        "returns": { "type": "string", "description": "The name of an earlier section of the size." },
        "variation": { "enum": ["exact", "ornament", "reharmonize", "reregister", "varied", "figurate"], "description": "Needs returns. figurate needs a figure." },
        "layers": {
          "oneOf": [
            { "const": "all" },
            { "type": "array", "minItems": 1, "items": { "enum": ["bass", "inner_voice", "melody"] } }
          ]
        },
        "pedal": { "enum": ["dominant"], "description": "The presentation is written over a dominant pedal; needs a presentation beginning." },
        "leads_in": { "type": "boolean", "description": "The section is held until the sections after it are written, then filled against them; not on the last section, a returning section, a section another returns, or two in a row." },
        "connective": { "enum": ["sometimes", "always"], "description": "The held section ends with a short stepwise connective into the next section's first note; needs leads_in." },
        "mode": { "enum": ["parallel"], "description": "The section is in the home key's parallel key (R-499); needs variation figurate, no keys; its figure is reharmonized." },
        "figure": {
          "type": "object",
          "required": ["kind", "rhythm"],
          "additionalProperties": false,
          "description": "The motive of variation of a figurate return (R-497); needs variation figurate and bars.",
          "properties": {
            "kind": { "enum": ["neighbor", "scale", "broken-chord"] },
            "rhythm": { "enum": ["eighths", "sixteenths"] },
            "harmony": { "enum": ["kept", "reharmonized"], "description": "Default kept (reharmonized in the parallel mode, which refuses kept); reharmonized puts the figure over a reharmonized copy." },
            "change_at": { "type": "integer", "minimum": 1, "description": "A bar of the section before its last at which the root must change; needs harmony reharmonized." },
            "climax": { "type": "boolean", "description": "An octave higher when it fits the melody range; default false." }
          }
        },
        "construction": {
          "description": "The section is a theme of 3 to 16 whole bars: \"auto\" (chosen from the bars and the piece's motive) or the bars of each idea and its extensions. A theme-like section of bars other than 4 or 8 needs it; a returning section keeps its source's.",
          "oneOf": [
            { "const": "auto" },
            {
              "type": "object",
              "required": ["ideas"],
              "additionalProperties": false,
              "properties": {
                "ideas": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 16 }, "description": "Idea name to whole bars; the bars of the ideas and the extensions add up to the section's." },
                "extensions": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "required": ["kind"],
                    "additionalProperties": false,
                    "properties": {
                      "kind": { "enum": ["repeat", "stretch", "addition", "evaded"] },
                      "idea": { "type": ["string", "null"], "description": "The idea a repeat or a stretch follows." },
                      "bars": { "type": "integer", "minimum": 0, "maximum": 4 },
                      "varied": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
