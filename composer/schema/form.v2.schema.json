{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz/composer/schema/form.v2.schema.json",
  "title": "Ursatz Composer form, version 2",
  "description": "A form as a document, version 2 (R-416, R-606): its sections at each size it comes in, the keys a piece may move to, the cadences, the returns and the checks that apply. See docs/forms.md. A section is the form use of the section description (library/plan/schema/section.schema.json); a region lists the relations of the knowledge snapshot it is reached by.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "name",
    "label"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ursatz-form"
    },
    "version": {
      "const": 2
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63
    },
    "plan_name": {
      "$ref": "#/$defs/name"
    },
    "closing": {
      "type": "boolean",
      "default": false
    },
    "modulates": {
      "type": "boolean",
      "default": false
    },
    "accompaniment": {
      "enum": [
        "optional",
        "required"
      ],
      "default": "optional"
    },
    "regions": {
      "type": "array",
      "maxItems": 4,
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "name",
          "major",
          "minor"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/name",
            "not": {
              "const": "home"
            }
          },
          "major": {
            "$ref": "#/$defs/relations"
          },
          "minor": {
            "$ref": "#/$defs/relations"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "enum": [
          "sections",
          "returns",
          "keys",
          "cadences",
          "seam"
        ]
      },
      "uniqueItems": true
    },
    "meters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "enum": [
          "2/4",
          "3/4",
          "4/4",
          "6/8"
        ]
      },
      "uniqueItems": true
    },
    "tempo": {
      "type": "integer",
      "minimum": 30,
      "maximum": 300
    },
    "repeats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "A compound form (R-485): each part is a piece of a built-in form with sizes, composed on its own and performed in order; its sizes have bars and no sections.",
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "sizes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/size"
      }
    },
    "sections": {
      "const": "request"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "intro",
          "body",
          "turnaround",
          "ending"
        ]
      },
      "description": "A form whose sections the request gives: the roles a section may have, in the order intro, body, turnaround, ending, and including body (until P45)."
    },
    "loop": {
      "type": "object",
      "required": [
        "roles"
      ],
      "additionalProperties": false,
      "properties": {
        "roles": {
          "$ref": "#/$defs/partRoles",
          "description": "The roles that are the loop: its end is held for the seam stage and a seam bar follows it; the ending version replaces the turnaround with the ending. Each is one of the form's roles."
        }
      }
    },
    "cadences": {
      "type": "object",
      "required": [
        "default"
      ],
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/cadenceName",
          "description": "The cadence of a section the request gives none."
        },
        "last": {
          "type": "array",
          "maxItems": 4,
          "description": "Applied in order: the last section whose role is in roles ends in cadence.",
          "items": {
            "type": "object",
            "required": [
              "roles",
              "cadence"
            ],
            "additionalProperties": false,
            "properties": {
              "roles": {
                "$ref": "#/$defs/partRoles"
              },
              "cadence": {
                "$ref": "#/$defs/cadenceName"
              }
            }
          }
        }
      }
    },
    "default_ending": {
      "type": "object",
      "required": [
        "id",
        "letter",
        "role",
        "bars",
        "cadence"
      ],
      "additionalProperties": false,
      "description": "The section a request with no ending gets.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "letter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3
        },
        "role": {
          "const": "ending"
        },
        "bars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "cadence": {
          "$ref": "#/$defs/cadenceName"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "sizes"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "sections"
            ]
          },
          {
            "required": [
              "roles"
            ]
          },
          {
            "required": [
              "loop"
            ]
          },
          {
            "required": [
              "cadences"
            ]
          },
          {
            "required": [
              "default_ending"
            ]
          },
          {
            "required": [
              "parts"
            ]
          }
        ]
      },
      "properties": {
        "sizes": {
          "items": {
            "required": [
              "sections"
            ]
          }
        }
      }
    },
    {
      "required": [
        "sizes",
        "parts"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "sections"
            ]
          },
          {
            "required": [
              "roles"
            ]
          },
          {
            "required": [
              "loop"
            ]
          },
          {
            "required": [
              "cadences"
            ]
          },
          {
            "required": [
              "default_ending"
            ]
          },
          {
            "required": [
              "repeats"
            ]
          }
        ]
      },
      "properties": {
        "sizes": {
          "items": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sections"
                  ]
                },
                {
                  "required": [
                    "count"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "required": [
        "sections",
        "roles",
        "loop",
        "cadences"
      ],
      "not": {
        "required": [
          "sizes"
        ]
      }
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,31}$"
    },
    "cadenceName": {
      "type": "string",
      "description": "A name of the standard-harmony cadence vocabulary whose core is a PAC, an IAC or an HC."
    },
    "partRoles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "enum": [
          "intro",
          "body",
          "turnaround",
          "ending"
        ]
      }
    },
    "part": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "form"
          ],
          "not": {
            "required": [
              "again"
            ]
          }
        },
        {
          "required": [
            "again"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "form"
                ]
              },
              {
                "required": [
                  "key"
                ]
              },
              {
                "required": [
                  "motive"
                ]
              },
              {
                "required": [
                  "bars"
                ]
              }
            ]
          }
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31,
          "description": "Unique among the parts; the prefix of its sections' names after the first part."
        },
        "form": {
          "$ref": "#/$defs/name",
          "description": "A built-in form with sizes that is not itself compound, with a size of each of the form's bars."
        },
        "key": {
          "type": "string",
          "default": "home",
          "description": "\"home\" or the name of a region of the form: the key the part is in."
        },
        "motive": {
          "enum": [
            "piece",
            "new"
          ],
          "default": "piece",
          "description": "The piece's motive, or one of its own, invented."
        },
        "again": {
          "type": "string",
          "description": "The name of an earlier part that is not an again part: this part performs it once more."
        },
        "repeats": {
          "type": "boolean",
          "description": "Whether the part's repeats are written out; true, and false for an again part."
        },
        "bars": {
          "type": "integer",
          "minimum": 1,
          "description": "The size of the part's form it is composed at, in place of the compound size's bars; the form has a size of these bars. Not with again."
        }
      }
    },
    "size": {
      "type": "object",
      "required": [
        "bars"
      ],
      "additionalProperties": false,
      "properties": {
        "bars": {
          "type": "integer",
          "minimum": 1,
          "description": "The sum of its sections' bars."
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "The variations or layers the size has."
        },
        "default": {
          "type": "boolean",
          "description": "The size a request gets when it asks for none; exactly one size has it."
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "https://github.com/Mitchell-Opitz/Ursatz/library/plan/schema/section.schema.json#/$defs/form_section"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "description": "A relation of the knowledge snapshot, such as omt.relation.dominant (K6)."
      }
    }
  }
}
