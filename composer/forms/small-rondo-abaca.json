      {"name": "C", "letter": "C", "role": "contrast", "bars": 8, "beginning": "antecedent", "ending": "consequent", "cadence": "perfect-authentic", "keys": {"start": "second", "end": "second"}, "motive": "interval-change"},
      {"name": "R1", "letter": "R", "role": "retransition", "bars": 4, "cadence": "half"},
      {"name": "A2", "letter": "A", "role": "return", "bars": 8, "beginning": "presentation", "ending": "continuation", "cadence": "perfect-authentic", "closed": true, "returns": "A", "variation": "setting", "setting": "arpeggiated"},
