# Writes the C file that holds the built-in form documents (the files in forms/): one NUL-terminated byte array per file, the
# names the files go by and their count. Run with cmake -P by src/CMakeLists.txt:
#   -DOUTPUT=<the .c file>  -DFILES=<the .json files, a ;-list, in registry order>
if(NOT OUTPUT OR NOT FILES)
    message(FATAL_ERROR "EmbedForms.cmake needs -DOUTPUT and -DFILES")
endif()

set(source "/* Generated by cmake/EmbedForms.cmake from the files in forms/. Do not edit. */\n#include <stddef.h>\n\n")
set(documents "")
set(names "")
set(index 0)
foreach(file ${FILES})
    get_filename_component(name "${file}" NAME_WE)
    file(READ "${file}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND source "static const unsigned char FORM_DOCUMENT_${index}[] = {${bytes}0x00};\n")
    string(APPEND documents "    (const char *)FORM_DOCUMENT_${index},\n")
    string(APPEND names "    \"${name}\",\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND source "\nconst char *const COMPOSER_FORM_DOCUMENTS[] = {\n${documents}};\n")
string(APPEND source "const char *const COMPOSER_FORM_NAMES[] = {\n${names}};\n")
string(APPEND source "const size_t COMPOSER_FORM_DOCUMENT_COUNT = ${index};\n")
file(WRITE "${OUTPUT}" "${source}")
