# Writes the C file that holds the built-in preset documents (the files in presets/): one NUL-terminated byte array per file, the
# names the files go by, the labels and the sources their documents give, and their count. Run with cmake -P by src/CMakeLists.txt:
#   -DOUTPUT=<the .c file>  -DFILES=<the .json files, a ;-list, in registry order>
if(NOT OUTPUT OR NOT FILES)
    message(FATAL_ERROR "EmbedPresets.cmake needs -DOUTPUT and -DFILES")
endif()

set(source "/* Generated by cmake/EmbedPresets.cmake from the files in presets/. Do not edit. */\n#include <stddef.h>\n\n")
set(documents "")
set(names "")
set(labels "")
set(sources "")
set(index 0)
foreach(file ${FILES})
    get_filename_component(name "${file}" NAME_WE)
    file(READ "${file}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND source "static const unsigned char PRESET_DOCUMENT_${index}[] = {${bytes}0x00};\n")
    string(APPEND documents "    (const char *)PRESET_DOCUMENT_${index},\n")
    string(APPEND names "    \"${name}\",\n")
    file(READ "${file}" text)
    string(JSON label GET "${text}" label)
    string(JSON from GET "${text}" source)
    string(APPEND labels "    \"${label}\",\n")
    string(APPEND sources "    \"${from}\",\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND source "\nconst char *const COMPOSER_PRESET_DOCUMENTS[] = {\n${documents}};\n")
string(APPEND source "const char *const COMPOSER_PRESET_NAMES[] = {\n${names}};\n")
string(APPEND source "const char *const COMPOSER_PRESET_LABELS[] = {\n${labels}};\n")
string(APPEND source "const char *const COMPOSER_PRESET_SOURCES[] = {\n${sources}};\n")
string(APPEND source "const size_t COMPOSER_PRESET_DOCUMENT_COUNT = ${index};\n")
file(WRITE "${OUTPUT}" "${source}")
