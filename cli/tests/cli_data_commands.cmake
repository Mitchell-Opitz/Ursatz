# The data folder subcommands of ursatz (P64 B8), run as processes on a copy of the layout 0 fixture folder.
# Run with: cmake -DURSATZ=<ursatz> -DDATA_V0=<fixture folder> -DWORK=<folder of its own> -P cli_data_commands.cmake

if(NOT URSATZ OR NOT DATA_V0 OR NOT WORK)
    message(FATAL_ERROR "give -DURSATZ, -DDATA_V0 and -DWORK")
endif()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(COPY "${DATA_V0}/" DESTINATION "${WORK}/data")
set(DATA "${WORK}/data")

# Runs ursatz in WORK with the arguments; sets out (stdout and stderr together) and status.
function(ursatz)
    execute_process(COMMAND "${URSATZ}" ${ARGN} WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    set(out "${out}${err}" PARENT_SCOPE)
    set(status "${status}" PARENT_SCOPE)
endfunction()

macro(expect_status wanted what)
    if(NOT status EQUAL ${wanted})
        message(FATAL_ERROR "${what}: exit ${status}, expected ${wanted}:\n${out}")
    endif()
endmacro()

macro(expect_text pattern what)
    if(NOT out MATCHES "${pattern}")
        message(FATAL_ERROR "${what}: the output does not match '${pattern}':\n${out}")
    endif()
endmacro()

# A folder in layout 0 is refused with the commands to run.
ursatz(--data "${DATA}" query item.list)
expect_status(2 "an unmigrated folder")
expect_text("ursatz --data [^ ]+ migrate --dry-run, then ursatz --data [^ ]+ migrate" "the refusal names migrate")

# The dry run reports and writes nothing.
file(GLOB_RECURSE before RELATIVE "${DATA}" "${DATA}/*")
ursatz(--data "${DATA}" migrate --dry-run)
expect_status(0 "migrate --dry-run")
expect_text("\"dry_run\":[ \t]*true" "migrate --dry-run")
file(GLOB_RECURSE after RELATIVE "${DATA}" "${DATA}/*")
if(NOT before STREQUAL after OR EXISTS "${DATA}/data-folder.json")
    message(FATAL_ERROR "migrate --dry-run changed the folder")
endif()

# The migration makes layout 2, after a backup.
ursatz(--data "${DATA}" migrate --backup "${WORK}/backup")
expect_status(0 "migrate")
if(NOT EXISTS "${WORK}/backup")
    message(FATAL_ERROR "migrate wrote no backup")
endif()
file(READ "${DATA}/data-folder.json" marker)
string(JSON format GET "${marker}" format_version)
if(NOT format EQUAL 2)
    message(FATAL_ERROR "data-folder.json has format_version ${format}")
endif()

# The theme item of the fixture.
ursatz(--data "${DATA}" query item.list)
expect_status(0 "query item.list")
string(JSON items GET "${out}" items)
string(JSON count LENGTH "${items}")
set(theme "")
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    string(JSON name GET "${items}" ${i} name)
    if(name STREQUAL "Sentence theme")
        string(JSON theme GET "${items}" ${i} id)
    endif()
endforeach()
if(theme STREQUAL "")
    message(FATAL_ERROR "item.list has no 'Sentence theme':\n${items}")
endif()

ursatz(--data "${DATA}" show "item:${theme}")
expect_status(0 "show item")
expect_text("${theme}" "show item")
ursatz(--data "${DATA}" show "item:${theme}" --view bogus)
expect_status(1 "show --view bogus")
expect_text("unknown view 'bogus'" "show --view bogus")
ursatz(--data "${DATA}" show "item:${theme}" --view summary)
expect_status(0 "show --view summary")
expect_text("ursatz-text 1 view summary item:${theme}@v" "show --view summary")
ursatz(--data "${DATA}" show nothing)
expect_status(2 "show nothing")
expect_text("cannot read nothing" "show nothing")
ursatz(--data "${DATA}" show "item:")
expect_status(1 "show item:")
expect_text("not an address" "show item:")

# Compose, history, render.
ursatz(--data "${DATA}" compose "item:${theme}" --seed 1)
expect_status(0 "compose")
expect_text("item ${theme} version [0-9]+" "compose")
set(compose_out "${out}")
ursatz(--data "${DATA}" show "item:${theme}" --view summary)
expect_status(0 "show --view summary of the composed theme")
expect_text("ursatz-text 1 view summary item:${theme}@v" "show --view summary of the composed theme")
ursatz(--data "${DATA}" history "item:${theme}")
expect_status(0 "history")
expect_text("item.compose" "history")
expect_text("claude" "history")
ursatz(--data "${DATA}" render "item:${theme}" --midi "${WORK}/t.mid")
expect_status(0 "render item")
file(READ "${WORK}/t.mid" head HEX LIMIT 4)
if(NOT head STREQUAL "4d546864")
    message(FATAL_ERROR "t.mid does not start with MThd: ${head}")
endif()
ursatz(--data "${DATA}" render "item:${theme}")
expect_status(1 "render item without an output")

# Apply: a command goes through, a stale base version is refused.
file(WRITE "${WORK}/create.jsonl" "{\"command\":\"project.create\",\"params\":{\"name\":\"P\"}}\n")
ursatz(--data "${DATA}" apply "${WORK}/create.jsonl")
expect_status(0 "apply project.create")
expect_text("journal" "apply project.create")
file(WRITE "${WORK}/stale.jsonl" "{\"command\":\"item.save\",\"target\":\"${theme}\",\"base_version\":1,\"params\":{\"body\":{},\"note\":\"x\"}}\n")
ursatz(--data "${DATA}" apply "${WORK}/stale.jsonl")
expect_status(2 "apply with a stale base version")
expect_text("changed since you read it" "apply with a stale base version")
expect_text("current version" "apply with a stale base version")
# A command that answers with a job waits for it with --wait: the job finishes done (the job id outlives the reply it came in).
string(REGEX MATCH "version ([0-9]+)" ignored "${compose_out}")
set(compose_version "${CMAKE_MATCH_1}")
file(WRITE "${WORK}/compose.jsonl" "{\"command\":\"item.compose\",\"target\":\"${theme}\",\"base_version\":${compose_version},\"params\":{\"seed\":2}}\n")
ursatz(--data "${DATA}" apply "${WORK}/compose.jsonl" --wait)
expect_status(0 "apply --wait of item.compose")
expect_text("job [^ ]+  done" "apply --wait of item.compose")

# Critique (R-723): the critic judges a version of the theme and keeps the judgment with an id for each observation; a verdict is recorded on one.
ursatz(--data "${DATA}" critique "item:${theme}")
expect_status(0 "critique the current version of a theme")
expect_text("crt-[0-9a-f]+ score -?[0-9]+/[0-9]+" "critique the current version of a theme")
ursatz(--data "${DATA}" critique "item:${theme}@v1")
expect_status(2 "critique an older version of an item")
expect_text("changed since you read it" "critique an older version of an item")
ursatz(--data "${DATA}" critique "item:${theme}" --note "again" --format json)
expect_status(0 "critique the current version of a theme, as JSON")
string(JSON critique_id GET "${out}" id)
string(JSON observation_count LENGTH "${out}" observations)
if(NOT critique_id MATCHES "^crt-" OR observation_count LESS 1)
    message(FATAL_ERROR "the critique has no id or no observation: ${out}")
endif()
string(JSON observation GET "${out}" observations 0 id)
if(NOT observation MATCHES "^obs-")
    message(FATAL_ERROR "an observation has no id: ${out}")
endif()
ursatz(--data "${DATA}" critique --verdict "${observation}" disagree "item:${theme}" --note "I hear it fine")
expect_status(0 "a verdict on an observation")
expect_text("^vrd-[0-9a-f]+" "a verdict on an observation")
ursatz(--data "${DATA}" critique --verdict obs-0000000000000000 agree "item:${theme}")
expect_status(2 "a verdict on an observation the item does not hold")
expect_text("no observation" "a verdict on an observation the item does not hold")
ursatz(--data "${DATA}" critique --verdict "${observation}" maybe "item:${theme}")
expect_status(1 "a verdict that is neither agree nor disagree")
ursatz(--data "${DATA}" history "item:${theme}")
expect_status(0 "history of the item")
expect_text("ratings.critique" "the history lists the critique")
expect_text("ratings.verdict" "the history lists the verdict")

file(WRITE "${WORK}/actor.jsonl" "{\"command\":\"project.create\",\"actor\":\"x\",\"params\":{\"name\":\"Q\"}}\n")
ursatz(--data "${DATA}" apply "${WORK}/actor.jsonl")
expect_status(1 "apply with an actor")
expect_text("the actor comes from --actor" "apply with an actor")

# Explore saves a new version of the item, so it comes after the commands that read a base version.
# Explore: variations of the theme at a distance from it (it saves them as items, as compose does).
ursatz(--data "${DATA}" explore "item:${theme}" --distance 2 --seed 1)
expect_status(0 "explore")
expect_text("item ${theme} version [0-9]+" "explore")
ursatz(--data "${DATA}" explore "item:${theme}" --distance 9 --seed 1)
expect_status(1 "explore --distance 9")
expect_text("--distance must be a whole number from 1 to 8" "explore --distance 9")

# Restore: the next version is a copy of an older one.
ursatz(--data "${DATA}" restore "item:${theme}@v1")
expect_status(0 "restore")
expect_text("item ${theme} version [0-9]+ [(]restored v1[)]" "restore")
ursatz(--data "${DATA}" restore "item:${theme}")
expect_status(1 "restore without a version")
expect_text("restore needs the version to copy" "restore without a version")

# Rate: a version of an item is rated against the version it names (R-679): the current one goes through, an older one is refused as stale.
ursatz(--data "${DATA}" restore "item:${theme}@v1")
expect_status(0 "restore again")
string(REGEX MATCH "version ([0-9]+) [(]restored" ignored "${out}")
set(current_version "${CMAKE_MATCH_1}")
ursatz(--data "${DATA}" rate "item:${theme}@v${current_version}" --rating 4)
expect_status(0 "rate the current version of an item")
expect_text("rat-" "rate the current version of an item")
ursatz(--data "${DATA}" rate "item:${theme}@v1" --rating 4)
expect_status(2 "rate an older version of an item")
expect_text("changed since you read it" "rate an older version of an item")

message(STATUS "ok")
