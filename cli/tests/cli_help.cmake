# The help of ursatz, from the command table and the flag table (R-657), run as a process.
# Run with: cmake -DURSATZ=<ursatz> -P cli_help.cmake

function(run_ursatz out_var status_var)
    execute_process(COMMAND "${URSATZ}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    set(${out_var} "${out}" PARENT_SCOPE)
    set(${status_var} "${status}" PARENT_SCOPE)
    set(ursatz_err "${err}" PARENT_SCOPE)
endfunction()

# The list of commands.
run_ursatz(list status --help)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "ursatz --help: exit ${status}")
endif()
if(NOT list MATCHES "^Usage: ursatz <command> \\[options\\]")
    message(FATAL_ERROR "ursatz --help does not start with the usage:\n${list}")
endif()
string(REGEX MATCHALL "\n  [a-z-]+ " names "${list}")
list(LENGTH names count)
# The help lists exactly the commands of the table: the names of the rows of CLI_COMMANDS in commands.c (COMMANDS_SOURCE), each present, and as many.
file(STRINGS "${COMMANDS_SOURCE}" rows REGEX "^    \\{\"[a-z-]+\",$")
list(LENGTH rows row_count)
if(row_count LESS 18)
    message(FATAL_ERROR "found only ${row_count} command rows in ${COMMANDS_SOURCE}")
endif()
if(NOT count EQUAL row_count)
    message(FATAL_ERROR "ursatz --help lists ${count} commands, the table has ${row_count}:\n${list}")
endif()
foreach(row ${rows})
    string(REGEX REPLACE "^    \\{\"([a-z-]+)\",$" "\\1" row_name "${row}")
    if(NOT list MATCHES "\n  ${row_name} ")
        message(FATAL_ERROR "ursatz --help does not list the command ${row_name}:\n${list}")
    endif()
endforeach()
run_ursatz(help_word status help)
if(NOT status EQUAL 0 OR NOT help_word STREQUAL list)
    message(FATAL_ERROR "ursatz help and ursatz --help differ")
endif()

foreach(raw ${names})
    string(STRIP "${raw}" command)
    run_ursatz(by_word status_word help ${command})
    run_ursatz(by_flag status_flag ${command} --help)
    if(NOT status_word EQUAL 0 OR NOT status_flag EQUAL 0)
        message(FATAL_ERROR "ursatz help ${command}: exit ${status_word}, ${command} --help: exit ${status_flag}")
    endif()
    if(NOT by_word STREQUAL by_flag)
        message(FATAL_ERROR "ursatz help ${command} and ursatz ${command} --help differ")
    endif()
    if(NOT by_word MATCHES "^Usage: ursatz ${command}")
        message(FATAL_ERROR "the help of ${command} does not start with 'Usage: ursatz ${command}':\n${by_word}")
    endif()
    # The usage lists every flag the command takes, and the options hold one line for each of them.
    string(FIND "${by_word}" "\nOptions:\n" options_at)
    if(options_at LESS 0)
        message(FATAL_ERROR "the help of ${command} has no Options")
    endif()
    string(SUBSTRING "${by_word}" 0 ${options_at} before)
    string(SUBSTRING "${by_word}" ${options_at} -1 options)
    string(FIND "${before}" "\n\n" usage_end)
    string(SUBSTRING "${before}" 0 ${usage_end} usage)
    string(REGEX MATCHALL "\n  --[a-z0-9-]+" lines "${options}")
    foreach(line ${lines})
        string(STRIP "${line}" flag)
        if(NOT flag STREQUAL "--help" AND NOT usage MATCHES "${flag}[] >|]|${flag}$|${flag}\\)")
            message(FATAL_ERROR "the usage of ${command} does not name ${flag}:\n${usage}")
        endif()
    endforeach()
    string(REGEX MATCHALL "--[a-z0-9-]+" in_usage "${usage}")
    foreach(flag ${in_usage})
        if(NOT options MATCHES "\n  ${flag}[ ,\n]")
            message(FATAL_ERROR "the options of ${command} do not have a line for ${flag}")
        endif()
    endforeach()
    if(NOT by_word MATCHES "Example:" OR NOT by_word MATCHES "Exit status")
        message(FATAL_ERROR "the help of ${command} has no Example: or Exit status")
    endif()
endforeach()

# An unknown command, and a command given an unknown flag.
run_ursatz(out status bogus)
if(NOT status EQUAL 1 OR NOT ursatz_err MATCHES "unknown command 'bogus'")
    message(FATAL_ERROR "ursatz bogus: exit ${status}, stderr '${ursatz_err}'")
endif()
run_ursatz(out status progression --bogus)
if(NOT status EQUAL 1 OR NOT ursatz_err MATCHES "unknown option '--bogus'")
    message(FATAL_ERROR "ursatz progression --bogus: exit ${status}, stderr '${ursatz_err}'")
endif()
