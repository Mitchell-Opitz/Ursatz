# Ursatz Text on the command line (P65 B6), run as processes on a migrated copy of the layout 0 fixture folder: show with its views, apply with text commands,
# the generated help.
# Run with: cmake -DURSATZ=<ursatz> -DDATA_V0=<fixture folder> -DPLAN=<a plan file> -DWORK=<folder of its own> -P cli_text.cmake

if(NOT URSATZ OR NOT DATA_V0 OR NOT PLAN OR NOT WORK)
    message(FATAL_ERROR "give -DURSATZ, -DDATA_V0, -DPLAN and -DWORK")
endif()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(COPY "${DATA_V0}/" DESTINATION "${WORK}/data")
set(DATA "${WORK}/data")
set(PIECE pce-2c8d54834a9c499f)

function(ursatz)
    execute_process(COMMAND "${URSATZ}" ${ARGN} WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    set(stdout "${out}" PARENT_SCOPE)
    set(out "${out}${err}" PARENT_SCOPE)
    set(status "${status}" PARENT_SCOPE)
endfunction()

macro(expect_status wanted what)
    if(NOT status EQUAL ${wanted})
        message(FATAL_ERROR "${what}: exit ${status}, expected ${wanted}:\n${out}")
    endif()
endmacro()

macro(expect_text pattern what)
    if(NOT out MATCHES "${pattern}")
        message(FATAL_ERROR "${what}: the output does not match '${pattern}':\n${out}")
    endif()
endmacro()

ursatz(--data "${DATA}" migrate)
expect_status(0 "migrate")

# show: the views of an item version, a section, a file
ursatz(--data "${DATA}" show "item:${PIECE}")
expect_status(0 "show item")
expect_text("^ursatz-text 1 view summary item:${PIECE}@v2\n" "show item (the summary of the current version)")
expect_text("\n  s0  bars 1-8  role body" "show item")
ursatz(--data "${DATA}" show "item:${PIECE}" --view structure)
expect_status(0 "show --view structure")
expect_text("form structure  bars 1-" "show --view structure")
ursatz(--data "${DATA}" show "item:${PIECE}" --view full)
expect_status(0 "show --view full")
expect_text("^ursatz-text 1 plan\n" "show --view full")
file(WRITE "${WORK}/full.txt" "${stdout}")
ursatz(--data "${DATA}" show "item:${PIECE}" --view json)
expect_status(0 "show --view json")
ursatz(show "${WORK}/full.txt" --view json)
expect_status(0 "show of the saved full text as json")
string(JSON from_text GET "${stdout}" form kind)
if(NOT from_text STREQUAL "form")
    message(FATAL_ERROR "the json of the saved text has no form: ${stdout}")
endif()

ursatz(show "${PLAN}" --view harmony --measures 1-2)
expect_status(0 "show of a file")
expect_text("^ursatz-text 1 view harmony ${PLAN}\nkey D major from bar 1\nbar 1  I IV@3\nbar 2  V\n# leaves out: [^\n]*bars outside 1-2\n" "show of a file with a measure range")
ursatz(--data "${DATA}" show "item:${PIECE}/s0" --view summary)
expect_status(0 "show a section")
expect_text("  s0  bars 1-8" "show a section")
if(out MATCHES "  seam  ")
    message(FATAL_ERROR "show of a section lists another section:\n${out}")
endif()
ursatz(--data "${DATA}" show "item:${PIECE}" --view summary --measures 9-10)
expect_status(0 "show --measures")
expect_text("bars outside 9-10" "show --measures")

# the refusals
ursatz(--data "${DATA}" show "item:${PIECE}" --view bogus)
expect_status(1 "show --view bogus")
expect_text("unknown view 'bogus'" "show --view bogus")
ursatz(--data "${DATA}" show "item:${PIECE}/nope" --view structure)
expect_status(1 "show an unknown section")
expect_text("unknown section 'nope'" "show an unknown section")
ursatz(--data "${DATA}" show "item:${PIECE}" --measures 9000-9001)
expect_status(1 "show measures outside the piece")
expect_text("outside the piece" "show measures outside the piece")
ursatz(--data "${DATA}" show "item:${PIECE}" --measures x)
expect_status(1 "show --measures x")
ursatz(--data "${DATA}" query project.list)
expect_status(0 "query project.list")
string(JSON project GET "${stdout}" projects 0 id)
ursatz(--data "${DATA}" show "project:${project}" --view summary)
expect_status(1 "show project --view summary")
expect_text("project addresses show only --view json" "show project --view summary")
ursatz(--data "${DATA}" show "project:${project}")
expect_status(0 "show project")
ursatz(--data "${DATA}" show "project:x/s0")
expect_status(1 "a section on a project address")
expect_text("not an address" "a section on a project address")

# apply: text commands journal under the actor claude
file(WRITE "${WORK}/make.txt" "# a project and a subject\nproject.create name demo\nsubject.create name hero kind character\n")
ursatz(--data "${DATA}" apply "${WORK}/make.txt")
expect_status(0 "apply of text commands")
expect_text("1  project.create  -  journal [0-9]+\n2  subject.create  -  journal [0-9]+\n" "apply of text commands")
ursatz(--data "${DATA}" history --limit 2)
expect_status(0 "history")
expect_text("claude  subject.create" "history")
expect_text("claude  project.create" "history")
ursatz(--data "${DATA}" apply "${WORK}/make.txt" --format json)
expect_status(0 "apply --format json")
file(WRITE "${WORK}/bad.txt" "project.create name fine\nproject.create nme oops\n")
ursatz(--data "${DATA}" apply "${WORK}/bad.txt")
expect_status(1 "apply of a text line with an unknown param")
expect_text("line 2: project.create takes no param 'nme'" "apply of a text line with an unknown param")
ursatz(--data "${DATA}" query project.list)
string(JSON before LENGTH "${stdout}" projects)
ursatz(--data "${DATA}" apply "${WORK}/bad.txt")
ursatz(--data "${DATA}" query project.list)
string(JSON after LENGTH "${stdout}" projects)
if(NOT before EQUAL after)
    message(FATAL_ERROR "a text with a mistake applied something: ${before} projects before, ${after} after")
endif()

# the generated help
ursatz(help commands)
expect_status(0 "help commands")
foreach(command item.save item.compose project.create library.import job.cancel subject.relate collection.add-pieces style.build links.run)
    expect_text("\n${command} " "help commands lists ${command}")
endforeach()
ursatz(help commands --format json)
expect_status(0 "help commands --format json")
string(JSON count LENGTH "${stdout}")
if(NOT count EQUAL 56)
    message(FATAL_ERROR "help commands --format json lists ${count} commands")
endif()
ursatz(help item.save)
expect_status(0 "help item.save")
expect_text("body  object, required" "help item.save")
expect_text("Base: name the version you read" "help item.save")
ursatz(help item.nope)
expect_status(1 "help item.nope")
expect_text("unknown command 'item.nope'" "help item.nope")
ursatz(help grammar)
expect_status(0 "help grammar")
expect_text("^[(][*] Commands in Ursatz Text, grammar 1" "help grammar")
ursatz(help commands --format bogus)
expect_status(1 "help commands --format bogus")

message(STATUS "ok")
