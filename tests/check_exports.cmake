# Fails when an application library exports a symbol its export file does not list, or lacks one it does (R-640).
#   cmake -DNM=<nm> "-DCHECKS=<library>|<export file>;<library>|<export file>" -P check_exports.cmake
# Each library is an archive of one relocatable object (cmake/UrsatzExports.cmake): `nm -g --defined-only` lists its global
# symbols, one "<address> <type> <name>" line each.
if(NOT NM OR NOT CHECKS)
    message(FATAL_ERROR "check_exports.cmake: give -DNM and -DCHECKS")
endif()

set(failed FALSE)
foreach(check IN LISTS CHECKS)
    set(library_failed FALSE)
    string(REPLACE "|" ";" parts "${check}")
    list(GET parts 0 library)
    list(GET parts 1 export_file)
    get_filename_component(shown "${library}" NAME)

    file(STRINGS "${export_file}" wanted)
    list(FILTER wanted EXCLUDE REGEX "^[ \t]*(#.*)?$")
    list(SORT wanted)

    execute_process(COMMAND ${NM} -g --defined-only "${library}" OUTPUT_VARIABLE listing RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(SEND_ERROR "${shown}: nm failed on ${library}")
        set(failed TRUE)
        continue()
    endif()
    string(REPLACE "\n" ";" lines "${listing}")
    set(found "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^[0-9a-fA-F]+ [A-Za-z] ([^ ]+)$")
            list(APPEND found "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES found)
    list(SORT found)

    set(extra ${found})
    list(REMOVE_ITEM extra ${wanted})
    set(missing ${wanted})
    list(REMOVE_ITEM missing ${found})
    list(LENGTH found found_count)
    list(LENGTH wanted wanted_count)
    if(extra)
        list(LENGTH extra extra_count)
        string(REPLACE ";" "\n  " shown_extra "${extra}")
        message(SEND_ERROR "${shown} exports ${extra_count} symbols its export file does not list:\n  ${shown_extra}")
        set(failed TRUE)
        set(library_failed TRUE)
    endif()
    if(missing)
        string(REPLACE ";" "\n  " shown_missing "${missing}")
        message(SEND_ERROR "${shown} does not export what its export file lists:\n  ${shown_missing}")
        set(failed TRUE)
        set(library_failed TRUE)
    endif()
    if(NOT library_failed)
        message(STATUS "${shown} exports exactly its ${wanted_count} listed symbols")
    endif()
endforeach()
