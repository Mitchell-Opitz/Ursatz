# Fails when a public header includes a header that is not public in its own
# target or in a target it links (R-223). Run with
#   cmake -DBINARY_DIR=<build dir> -P cmake/check_public_headers.cmake
# It reads the manifest the configure step wrote (public/manifest.txt) and looks
# at the staged copies, so what it sees is what a consumer sees.
cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED BINARY_DIR)
    message(FATAL_ERROR "BINARY_DIR is required")
endif()
file(STRINGS "${BINARY_DIR}/public/manifest.txt" lines)

foreach(line IN LISTS lines)
    if(NOT line MATCHES "^([^|]*)\\|([^|]*)\\|([^|]*)\\|(.*)$")
        message(FATAL_ERROR "bad manifest line: ${line}")
    endif()
    set(name "${CMAKE_MATCH_1}")
    set(root_${name} "${CMAKE_MATCH_2}")
    set(links_${name} "${CMAKE_MATCH_3}")
    set(headers_${name} "${CMAKE_MATCH_4}")
    list(APPEND targets ${name})
endforeach()

# The roots a target sees: its own and those of everything it links, transitively.
function(visible_roots target out)
    set(todo ${target})
    set(seen "")
    set(roots "")
    while(todo)
        list(POP_FRONT todo t)
        if(t IN_LIST seen)
            continue()
        endif()
        list(APPEND seen ${t})
        list(APPEND roots "${root_${t}}")
        string(REPLACE "," ";" linked "${links_${t}}")
        list(APPEND todo ${linked})
    endwhile()
    set(${out} "${roots}" PARENT_SCOPE)
endfunction()

set(violations 0)
foreach(target IN LISTS targets)
    visible_roots(${target} roots)
    string(REPLACE "," ";" headers "${headers_${target}}")
    foreach(header IN LISTS headers)
        set(file "${root_${target}}/${header}")
        get_filename_component(dir "${file}" DIRECTORY)
        file(STRINGS "${file}" includes REGEX "^[ \t]*#[ \t]*include[ \t]*\"")
        foreach(include_line IN LISTS includes)
            string(REGEX REPLACE "^[ \t]*#[ \t]*include[ \t]*\"([^\"]+)\".*" "\\1" included "${include_line}")
            set(found FALSE)
            if(EXISTS "${dir}/${included}")
                set(found TRUE)
            endif()
            foreach(root IN LISTS roots)
                if(EXISTS "${root}/${included}")
                    set(found TRUE)
                endif()
            endforeach()
            if(NOT found)
                message(SEND_ERROR "${target}: public header ${header} includes \"${included}\", which is not public in ${target} or a target it links")
                math(EXPR violations "${violations} + 1")
            endif()
        endforeach()
    endforeach()
endforeach()

if(violations GREATER 0)
    message(FATAL_ERROR "${violations} public header include(s) of a non-public header")
endif()
list(LENGTH targets count)
message(STATUS "public headers: every include of a public header is public (${count} targets)")
