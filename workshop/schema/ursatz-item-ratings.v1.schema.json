{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz/workshop/schema/ursatz-item-ratings.v1.schema.json",
  "title": "Item ratings, format version 1",
  "description": "ratings/items/<item id>.json: the ratings of the versions of one item (R-674).",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "item_id",
    "ratings"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "ursatz-item-ratings"
    },
    "format_version": {
      "const": 1
    },
    "item_id": {
      "type": "string"
    },
    "ratings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "rating",
          "note",
          "actor",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "note": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      }
    }
  }
}
