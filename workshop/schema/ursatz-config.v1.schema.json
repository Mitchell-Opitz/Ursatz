{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz/workshop/schema/ursatz-config.v1.schema.json",
  "title": "Workshop settings, format version 1",
  "description": "The settings file (ursatz.json in the data folder, R-641): every member is optional.",
  "type": "object",
  "required": [
    "format",
    "format_version"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "ursatz-config"
    },
    "format_version": {
      "const": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "http_threads": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "job_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    }
  }
}
