{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K4 vocabulary: a harmonic function",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]+([ _-][a-z]+)*$"
        }
      }
    }
  }
}
