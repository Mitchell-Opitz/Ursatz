{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K3 voicing: how a chord's members are spread over the registers",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "members",
        "fits"
      ],
      "additionalProperties": false,
      "properties": {
        "members": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "prefixItems": [
            {
              "type": "object",
              "required": [
                "role",
                "semitones"
              ],
              "properties": {
                "role": {
                  "const": "root"
                },
                "semitones": {
                  "const": 0
                }
              }
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "role",
              "semitones"
            ],
            "additionalProperties": false,
            "properties": {
              "role": {
                "enum": [
                  "root",
                  "third",
                  "fifth",
                  "seventh",
                  "ninth",
                  "eleventh",
                  "thirteenth",
                  "added-second",
                  "added-sixth",
                  "suspended-fourth"
                ]
              },
              "semitones": {
                "type": "integer",
                "minimum": 0,
                "maximum": 35
              }
            }
          }
        },
        "fits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(user|[a-z0-9]+(-[a-z0-9]+)*)\\.chord-type\\.[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "root",
          "pitches"
        ],
        "additionalProperties": false,
        "properties": {
          "root": {
            "type": "string",
            "pattern": "^[A-G][#b]?$"
          },
          "pitches": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^[A-G][#b]?$"
            }
          }
        }
      }
    }
  }
}
