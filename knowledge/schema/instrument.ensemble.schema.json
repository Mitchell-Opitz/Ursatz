{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K12 ensemble template: named slots, each an instrument played by one or more performers",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "slots"
      ],
      "additionalProperties": false,
      "properties": {
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "instrument",
              "name",
              "players"
            ],
            "additionalProperties": false,
            "properties": {
              "instrument": {
                "type": "string",
                "pattern": "^(user|[a-z0-9]+(-[a-z0-9]+)*)\\.[a-z]+(-[a-z]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "players": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "performers"
        ],
        "additionalProperties": false,
        "properties": {
          "performers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
