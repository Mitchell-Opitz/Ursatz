{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K2 chord type",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "construction",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "construction": {
          "enum": [
            "tertian",
            "quartal",
            "secundal",
            "added-note",
            "polychord",
            "compound",
            "cluster",
            "power"
          ]
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "type": "object",
              "required": [
                "role",
                "semitones"
              ],
              "properties": {
                "role": {
                  "const": "root"
                },
                "semitones": {
                  "const": 0
                }
              }
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "role",
              "semitones"
            ],
            "additionalProperties": false,
            "properties": {
              "role": {
                "enum": [
                  "root",
                  "third",
                  "fifth",
                  "seventh",
                  "ninth",
                  "eleventh",
                  "thirteenth",
                  "added-second",
                  "added-sixth",
                  "suspended-fourth"
                ]
              },
              "semitones": {
                "type": "integer",
                "minimum": 0,
                "maximum": 23
              }
            }
          }
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaults": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alterations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "root",
          "pitches"
        ],
        "additionalProperties": false,
        "properties": {
          "root": {
            "type": "string",
            "pattern": "^[A-G][#b]?$"
          },
          "pitches": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "pattern": "^[A-G][#b]?$"
            }
          },
          "symbol": {
            "type": "string"
          }
        }
      }
    }
  }
}
