{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K1 pitch material, unordered: a collection above a center",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          },
          "prefixItems": [
            {
              "const": 0
            }
          ]
        },
        "descending_steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          },
          "prefixItems": [
            {
              "const": 0
            }
          ]
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*$"
        },
        "brightness_rank": {
          "type": "integer"
        },
        "color_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[#b]{0,2}(1[0-3]|[1-9])$"
          }
        },
        "key_word": {
          "type": "string",
          "pattern": "^[a-z]+( [a-z]+)*$"
        },
        "primary_chords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chords_to_avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "set_class": {
          "type": "string",
          "pattern": "^[0-9]{1,2}-[A-Za-z]?[0-9]{1,3}[AB]?$"
        }
      },
      "dependentSchemas": {
        "brightness_rank": {
          "required": [
            "family"
          ],
          "properties": {
            "family": {
              "const": "diatonic"
            }
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "center",
          "pitches"
        ],
        "additionalProperties": false,
        "properties": {
          "center": {
            "type": "string",
            "pattern": "^[A-G][#b]?$"
          },
          "pitches": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "pattern": "^[A-G][#b]?$"
            }
          },
          "descending": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "pattern": "^[A-G][#b]?$"
            }
          }
        }
      }
    }
  }
}
