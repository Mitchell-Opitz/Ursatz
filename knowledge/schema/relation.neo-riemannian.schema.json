{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K6 relation, neo-Riemannian: a chain of P, L and R moves",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "moves"
      ],
      "additionalProperties": false,
      "properties": {
        "moves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "P",
              "L",
              "R"
            ]
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "anchor",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "anchor": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
