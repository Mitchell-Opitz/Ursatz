{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K13 rule: an observation, a plain-word note on what was heard, never scored or refused",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "code",
        "scope",
        "message",
        "function"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]+([_-][a-z]+)*$"
        },
        "scope": {
          "enum": [
            "note",
            "line",
            "line-pair",
            "sonority",
            "progression",
            "phrase",
            "section",
            "movement",
            "performer-part",
            "set"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "function": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "styles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "textures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "independent_lines": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
