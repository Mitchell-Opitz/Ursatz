      "aliases": ["major scale", "ionian"],
      "content": { "steps": [0, 2, 4, 5, 7, 9, 11], "family": "diatonic", "brightness_rank": 6, "key_word": "major" },
      "citations": [{ "source": "omt", "part": "I", "chapter": 12, "example": 1,
