      "subtype": "cadence-kind",
      "name": "perfect authentic cadence",
      "aliases": [
        "PAC"
      ],
      "content": {
        "code": "perfect-authentic",
        "label": "perfect authentic",
        "abbreviation": "PAC",
        "core": "perfect-authentic",
        "strength": 6,
        "conclusive": true
      },
      "citations": [
        {
          "source": "omt",
          "part": "IV",
          "chapter": 1,
          "section": "Authentic Cadences",
          "note": "a perfect authentic cadence has V or V7 to I, both in root position, with the tonic in the soprano at the end"
        }
