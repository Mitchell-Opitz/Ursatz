{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K4 vocabulary: a cadence kind (the rows of the Composer's and the analyzer's cadence table)",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "code",
        "label",
        "abbreviation",
        "core",
        "strength",
        "conclusive"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]+([ _-][a-z]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "abbreviation": {
          "type": "string",
          "pattern": "^[A-Z]{2,3}$"
        },
        "core": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "type": "integer",
          "minimum": -1,
          "maximum": 10
        },
        "conclusive": {
          "type": "boolean"
        },
        "material": {
          "type": "string",
          "pattern": "^(user|[a-z0-9]+(-[a-z0-9]+)*)\\.material\\.[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "approach": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "pattern": "^(I|II|III|IV|V|VI|VII|i|ii|iii|iv|v|vi|vii)o?$"
          }
        },
        "arrival": {
          "type": "string",
          "pattern": "^(I|II|III|IV|V|VI|VII|i|ii|iii|iv|v|vi|vii)o?$"
        }
      },
      "dependentRequired": {
        "material": [
          "approach",
          "arrival"
        ],
        "approach": [
          "material",
          "arrival"
        ],
        "arrival": [
          "material",
          "approach"
        ]
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "center",
          "numerals"
        ],
        "additionalProperties": false,
        "properties": {
          "center": {
            "type": "string",
            "pattern": "^[A-G][#b]?$"
          },
          "numerals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(I|II|III|IV|V|VI|VII|i|ii|iii|iv|v|vi|vii)o?$"
            }
          }
        }
      }
    }
  }
}
