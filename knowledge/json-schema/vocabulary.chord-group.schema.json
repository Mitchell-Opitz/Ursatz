{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K4 vocabulary: a chord group of Hindemith's table, I (least tension) to VI (R-764)",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "code",
        "group",
        "rank",
        "tritones",
        "sharp",
        "root"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]+[a-z0-9]*$"
        },
        "group": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "tritones": {
          "enum": [
            "none",
            "one",
            "several",
            "any"
          ]
        },
        "sharp": {
          "enum": [
            "none",
            "mild",
            "sharp",
            "any"
          ]
        },
        "root": {
          "enum": [
            "bass",
            "above",
            "none",
            "any"
          ]
        }
      }
    }
  }
}
