{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K4 vocabulary: a progression type (a way a chord succession is built)",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]+([ _-][a-z]+)*$"
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "chords"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-G][#b]?$"
          },
          "chords": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^(b|#)?(I|II|III|IV|V|VI|VII|i|ii|iii|iv|v|vi|vii)(o|\\+)?(6|64|7|65|43|42)?$"
            }
          }
        }
      }
    }
  }
}
