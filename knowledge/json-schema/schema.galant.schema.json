{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K5 schema, galant: a galant schema's stages, the melody and bass degrees and the harmony of each",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "function",
        "bass_defining",
        "melody_in_tenths",
        "stages"
      ],
      "additionalProperties": false,
      "properties": {
        "function": {
          "enum": [
            "opening-gambit",
            "continuation",
            "pre-cadential",
            "cadence",
            "post-cadential"
          ]
        },
        "bass_defining": {
          "type": "boolean"
        },
        "melody_in_tenths": {
          "type": "boolean"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "strength",
              "melody",
              "bass",
              "figures",
              "numeral"
            ],
            "additionalProperties": false,
            "properties": {
              "strength": {
                "enum": [
                  "strong",
                  "weak"
                ]
              },
              "melody": {
                "type": "object",
                "required": [
                  "degree",
                  "alteration"
                ],
                "additionalProperties": false,
                "properties": {
                  "degree": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 7
                  },
                  "alteration": {
                    "enum": [
                      "natural",
                      "lowered",
                      "either",
                      "raised"
                    ]
                  }
                }
              },
              "bass": {
                "type": "object",
                "required": [
                  "degree",
                  "alteration"
                ],
                "additionalProperties": false,
                "properties": {
                  "degree": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 7
                  },
                  "alteration": {
                    "enum": [
                      "natural",
                      "lowered",
                      "either",
                      "raised"
                    ]
                  }
                }
              },
              "figures": {
                "type": "string"
              },
              "numeral": {
                "type": "string",
                "minLength": 1
              },
              "numeral_dominant": {
                "type": "string",
                "minLength": 1
              },
              "melody_next": {
                "type": "object",
                "required": [
                  "degree",
                  "alteration"
                ],
                "additionalProperties": false,
                "properties": {
                  "degree": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 7
                  },
                  "alteration": {
                    "enum": [
                      "natural",
                      "lowered",
                      "either",
                      "raised"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
