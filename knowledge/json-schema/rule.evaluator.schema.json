{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K13 rule: an evaluator, a weighted judgment of a candidate in her words",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "code",
        "scope",
        "message",
        "function",
        "default_weight"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]+([_-][a-z]+)*$"
        },
        "scope": {
          "enum": [
            "note",
            "line",
            "line-pair",
            "sonority",
            "progression",
            "phrase",
            "section",
            "movement",
            "performer-part",
            "set"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "function": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "styles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "textures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "independent_lines": {
              "type": "boolean"
            }
          }
        },
        "default_weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "parameters": {
          "type": "object",
          "maxProperties": 4,
          "propertyNames": {
            "pattern": "^[a-z_]+$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+/[1-9][0-9]*$"
              }
            ]
          }
        }
      }
    }
  }
}
