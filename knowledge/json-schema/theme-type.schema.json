{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K8 theme type: a beginning and an ending, and the ideas between them",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "beginning",
        "ending",
        "ideas"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*$"
        },
        "beginning": {
          "type": "string",
          "pattern": "^(user|[a-z0-9]+(-[a-z0-9]+)*)\\.[a-z]+(-[a-z]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "ending": {
          "type": "string",
          "pattern": "^(user|[a-z0-9]+(-[a-z0-9]+)*)\\.[a-z]+(-[a-z]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "ideas": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "function",
              "slot",
              "half",
              "units",
              "cadence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "function": {
                "type": "string",
                "pattern": "^(user|[a-z0-9]+(-[a-z0-9]+)*)\\.[a-z]+(-[a-z]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "slot": {
                "enum": [
                  "basic",
                  "contrasting",
                  "continuation",
                  "cadential"
                ]
              },
              "half": {
                "enum": [
                  "beginning",
                  "ending"
                ]
              },
              "units": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "cadence": {
                "enum": [
                  "none",
                  "first",
                  "final"
                ]
              },
              "expect": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "jobs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 5,
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "motif",
                          "variant",
                          "contrast",
                          "running",
                          "long",
                          "syncopated",
                          "liquidation",
                          "cadence"
                        ]
                      }
                    }
                  },
                  "harmony": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "chords",
                            "type"
                          ],
                          "properties": {
                            "chords": {
                              "type": "array",
                              "minItems": 1,
                              "maxItems": 8,
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "type": {
                              "type": "string",
                              "pattern": "^(user|[a-z0-9]+(-[a-z0-9]+)*)\\.[a-z]+(-[a-z]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "restate",
                            "type"
                          ],
                          "properties": {
                            "restate": {
                              "const": true
                            },
                            "type": {
                              "type": "string",
                              "pattern": "^(user|[a-z0-9]+(-[a-z0-9]+)*)\\.[a-z]+(-[a-z]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$"
                            }
                          }
                        }
                      ]
                    }
                  },
                  "climax": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 7
                    }
                  },
                  "sounds": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "unit",
                        "kinds"
                      ],
                      "properties": {
                        "unit": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 7
                        },
                        "kinds": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 5,
                          "uniqueItems": true,
                          "items": {
                            "enum": [
                              "ninth_downbeat",
                              "sus4_dominant",
                              "appoggiatura",
                              "major_seventh",
                              "leading_tone"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bars",
          "ideas"
        ],
        "additionalProperties": false,
        "properties": {
          "bars": {
            "enum": [
              4,
              8
            ]
          },
          "ideas": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "start",
                "end"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
