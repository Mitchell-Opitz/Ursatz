{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K6 relation, set: transposition or inversion",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "operation",
        "n"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "T",
            "I"
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "anchor",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "anchor": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
