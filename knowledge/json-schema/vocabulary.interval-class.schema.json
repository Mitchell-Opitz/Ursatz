{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K4 vocabulary: an interval class of Hindemith's Series 2 (R-764)",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "code",
        "semitones",
        "rank",
        "root"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]+([ _-][a-z]+)*$"
        },
        "semitones": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "root": {
          "enum": [
            "lower",
            "upper",
            "none"
          ]
        }
      }
    }
  }
}
