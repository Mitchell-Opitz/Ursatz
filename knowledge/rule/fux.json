    {
      "id": "fux.rule.dissonance-against-bass",
      "kind": "rule",
      "subtype": "constraint",
      "name": "dissonance against bass",
      "content": {
        "code": "dissonance-against-bass",
        "scope": "line-pair",
        "function": "melody_check",
        "message": "a dissonance against the bass in bar {bar}",
        "stage": "melody",
        "waivable": true,
        "setting": "melody.waive"
      },
      "citations": [
        {
          "source": "fux",
          "part": "I",
          "chapter": 1,
          "section": "Note against Note",
          "note": "only consonances are set note against note"
        }
      ],
      "status": "active",
      "version": 1,
