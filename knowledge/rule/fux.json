    {
      "id": "fux.rule.strong-beat-chord-tone",
      "kind": "rule",
      "subtype": "constraint",
      "name": "strong beat chord tone",
      "content": {
        "code": "strong-beat-chord-tone",
        "scope": "note",
        "function": "melody_check",
        "message": "a non-chord tone on the strong beat of bar {bar}",
        "stage": "melody",
        "waivable": true,
        "setting": "melody.waive"
      },
      "citations": [
        {
          "source": "fux",
          "part": "I",
          "chapter": 2,
          "section": "Second Species",
          "note": "the note on the downbeat is a consonance"
        }
      ],
      "status": "active",
      "version": 1,
      "examples": [
        {
          "message": "a non-chord tone on the strong beat of bar 2"
        }
      ]
    }
  ]
