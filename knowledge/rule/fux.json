      "name": "parallel octaves",
      "content": {
        "code": "parallel-octaves",
        "scope": "line-pair",
        "function": "standard_counterpoint_harmonic_check",
        "message": "parallel octaves into bar {bar}",
        "stage": "melody",
        "waivable": true,
        "setting": "melody.waive"
      },
      "citations": [
        {
          "source": "fux",
          "part": "I",
          "chapter": 1,
          "section": "Note against Note",
          "note": "two voices do not move in parallel octaves"
        }
      ],
      "status": "active",
      "version": 1,
      "examples": [
        {
          "message": "parallel octaves into bar 2"
        }
      ]
    },
