{
  "schema": "ursatz-knowledge",
  "schema_version": 1,
  "source": "fux",
  "entries": [
    {
      "id": "fux.rule.forbidden-leap",
      "kind": "rule",
      "subtype": "constraint",
      "name": "forbidden leap",
      "content": {
        "code": "forbidden-leap",
        "scope": "line",
        "function": "standard_counterpoint_melodic_check",
        "message": "a forbidden leap of {value} in bar {bar}",
        "stage": "melody",
        "waivable": true,
        "setting": "melody.waive"
      },
      "citations": [
        {
          "source": "fux",
          "part": "I",
          "chapter": 1,
          "section": "Note against Note",
          "note": "a melodic line avoids the tritone and the major sixth as leaps"
        }
      ],
      "status": "active",
      "version": 1,
      "examples": [
        {
          "message": "a forbidden leap of 6 in bar 3"
        }
      ]
    },
    {
      "id": "fux.rule.forbidden-outline",
      "kind": "rule",
      "subtype": "constraint",
      "name": "forbidden outline",
      "content": {
        "code": "forbidden-outline",
        "scope": "line",
        "function": "standard_counterpoint_melodic_check",
        "message": "the line outlines a {value} by bar {bar}",
        "stage": "melody",
        "waivable": true,
        "setting": "melody.waive"
      },
      "citations": [
        {
          "source": "fux",
          "part": "I",
          "chapter": 1,
          "section": "Note against Note",
          "note": "a line does not outline a tritone or a seventh within one direction"
        }
      ],
      "status": "active",
      "version": 1,
      "examples": [
        {
          "message": "the line outlines a 6 by bar 4"
        }
      ]
    },
    {
      "id": "fux.rule.no-crossing",
      "kind": "rule",
      "subtype": "constraint",
      "name": "no crossing",
      "content": {
        "code": "no-crossing",
        "scope": "line-pair",
        "function": "standard_counterpoint_harmonic_check",
        "message": "the voices cross in bar {bar}",
        "stage": "melody",
        "waivable": true,
        "setting": "melody.waive"
      },
      "citations": [
        {
          "source": "fux",
          "part": "I",
          "chapter": 1,
          "section": "Note against Note",
          "note": "an upper voice does not go below the voice under it"
        }
      ],
      "status": "active",
      "version": 1,
      "examples": [
        {
          "message": "the voices cross in bar 5"
        }
      ]
    },
    {
      "id": "fux.rule.parallel-octaves",
