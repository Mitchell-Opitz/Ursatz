{
  "schema": "ursatz-knowledge",
  "schema_version": 1,
  "source": "omt",
  "entries": [
    {
      "id": "omt.function.basic-idea",
      "kind": "function",
      "subtype": "formal-function",
      "name": "basic idea",
      "content": {
        "code": "basic-idea",
        "core": "initiating",
        "level": "idea",
        "harmony": [
          "omt.vocabulary.prolongational"
        ],
        "harmonic_rhythm": "any",
        "rhythmic_activity": "any",
        "motive_harmony": "keep"
      },
      "citations": [
        {
          "source": "omt",
          "part": "III",
          "chapter": 1,
          "section": "The Idea Level",
          "note": "the basic idea opens the theme and sets the motive the rest answers or develops"
        },
        {
          "source": "omt",
          "part": "III",
          "chapter": 2,
          "section": "More Detail: The Presentation",
          "note": "the presentation states the basic idea, then repeats it"
        },
        {
          "source": "schoenberg",
          "chapter": "V",
          "note": "the motive of the basic idea is stated and repeated"
        }
      ],
      "status": "active",
      "examples": [
        {
          "theme_type": "omt.theme-type.sentence",
          "idea": "basic idea"
        }
      ],
      "version": 1
    },
    {
      "id": "omt.function.contrasting-idea",
      "kind": "function",
      "subtype": "formal-function",
      "name": "contrasting idea",
      "content": {
        "code": "contrasting-idea",
        "core": "concluding",
        "level": "idea",
        "harmony": [
          "omt.vocabulary.cadential",
          "omt.vocabulary.prolongational"
        ],
        "harmonic_rhythm": "any",
        "rhythmic_activity": "any",
        "motive_harmony": "free",
        "contrast": {
          "against": "omt.function.basic-idea",
          "aspects": [
            {
              "aspect": "rhythm",
              "amount": "1/2"
            },
            {
              "aspect": "contour",
              "amount": "1/2"
            }
          ]
        }
      },
      "citations": [
        {
          "source": "omt",
          "part": "III",
          "chapter": 2,
          "section": "Archetype 2: The Period",
          "note": "the contrasting idea of a period answers the basic idea with other material and ends the half on a cadence"
        },
        {
          "source": "omt",
          "part": "III",
          "chapter": 2,
          "section": "More Detail: The Consequent",
          "note": "the consequent's contrasting idea closes the theme"
        },
        {
          "source": "schoenberg",
          "chapter": "VI",
          "note": "the remoter motive-forms of the third and fourth bars differ in register, direction or contour, and have more or fewer small notes"
        }
      ],
      "status": "active",
      "examples": [
        {
          "theme_type": "omt.theme-type.period",
          "idea": "contrasting idea"
        }
      ],
      "version": 1
    },
    {
      "id": "omt.function.fragment",
      "kind": "function",
      "subtype": "formal-function",
      "name": "fragment",
      "content": {
        "code": "fragment",
        "core": "medial",
        "level": "idea",
        "harmony": [
          "omt.vocabulary.prolongational",
          "omt.vocabulary.sequential"
        ],
        "harmonic_rhythm": "faster",
        "rhythmic_activity": "faster",
        "motive_harmony": "free"
      },
      "citations": [
        {
          "source": "omt",
          "part": "III",
          "chapter": 2,
          "section": "More Detail: The Continuation",
          "note": "the continuation fragments the idea, uses faster durations, sequences and a faster harmonic rhythm"
        },
        {
          "source": "schoenberg",
          "chapter": "VIII",
          "note": "fragmentation reduces the idea to a piece, condenses it and sequences it"
        }
      ],
      "status": "active",
      "examples": [
        {
          "theme_type": "omt.theme-type.sentence",
          "idea": "fragment 1"
        }
      ],
      "version": 1
    },
