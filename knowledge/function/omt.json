        "harmonic_rhythm": "faster",
        "rhythmic_activity": "slower",
        "motive_harmony": "free"
      },
      "citations": [
        {
          "source": "omt",
          "part": "III",
          "chapter": 3,
          "section": "New: Cadential",
          "note": "the cadential idea goes mi, fa, sol, do over I6, ii6 or IV, V and I"
        },
        {
          "source": "schoenberg",
          "chapter": "VIII",
          "note": "liquidation brings the continuation into the cadence"
        }
      ],
      "status": "active",
      "examples": [
        {
