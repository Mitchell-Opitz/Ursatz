# Checks ursatz style-profile: its flags and exit codes. Run with cmake -P and -DCLI=<ursatz>,
# -DCORPORA_DIR=<test corpora> and -DWORK_DIR=<scratch dir>. With -DSMOKE=1 only the corpus "small" is analyzed and
# profiled, and only the exit codes, the files written and, with -DPYTHON, -DVALIDATOR and -DSCHEMA (the style model
# schema), the schema are checked.

foreach(var CLI CORPORA_DIR WORK_DIR)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "${var} is not set")
    endif()
endforeach()

# check_case(<label> <expected exit code> <stderr pattern, or "" for none> <cli args>...); sets last_output to the CLI's standard output.
function(check_case label expected_exit stderr_pattern)
    execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL expected_exit)
        message(FATAL_ERROR "${label}: expected exit ${expected_exit}, got ${result}: ${error}")
    endif()
    if(NOT stderr_pattern STREQUAL "" AND NOT error MATCHES "${stderr_pattern}")
        message(FATAL_ERROR "${label}: expected '${stderr_pattern}' on stderr, got: ${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
    message(STATUS "${label}: ok")
endfunction()

function(expect_line label text)
    if(NOT last_output MATCHES "${text}")
        message(FATAL_ERROR "${label}: output lacks '${text}':\n${last_output}")
    endif()
endfunction()

if(SMOKE)
    file(REMOVE_RECURSE "${WORK_DIR}")
    set(SMALL "${WORK_DIR}/small")
    check_case("corpus small" 0 "" corpus "${CORPORA_DIR}/small" --out "${SMALL}")
    check_case("style-profile" 0 "" style-profile "${SMALL}" --name small)
    if(NOT EXISTS "${SMALL}/style-model.json")
        message(FATAL_ERROR "style-profile: expected ${SMALL}/style-model.json")
    endif()
    check_case("style-profile --out" 0 "" style-profile "${SMALL}" --name small --out "${WORK_DIR}/small.json")
    if(NOT EXISTS "${WORK_DIR}/small.json")
        message(FATAL_ERROR "style-profile --out: expected ${WORK_DIR}/small.json")
    endif()
    if(PYTHON)
        execute_process(COMMAND "${PYTHON}" "${VALIDATOR}" "${SCHEMA}" "${SMALL}/style-model.json" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "style model does not match the schema")
        endif()
        message(STATUS "style model: valid")
    else()
        message(STATUS "schema not checked: no python3 with jsonschema")
    endif()
    file(REMOVE_RECURSE "${WORK_DIR}")
    return()
endif()

file(REMOVE_RECURSE "${WORK_DIR}")
set(REFERENCE "${WORK_DIR}/reference")
set(SONATINAS "${WORK_DIR}/sonatinas")
check_case("corpus reference" 0 "" corpus "${CORPORA_DIR}/reference" --out "${REFERENCE}")
check_case("corpus sonatinas" 0 "" corpus "${CORPORA_DIR}/sonatinas" --out "${SONATINAS}")

# Profile: default output file, then --out.
check_case("style-profile" 0 "" style-profile "${REFERENCE}" --name reference)
expect_line("style-profile" "from 5 pieces")
if(NOT EXISTS "${REFERENCE}/style-model.json")
    message(FATAL_ERROR "style-profile: expected ${REFERENCE}/style-model.json")
endif()
check_case("style-profile --out" 0 "" style-profile "${SONATINAS}" --name sonatinas --out "${WORK_DIR}/sonatinas.json")
if(NOT EXISTS "${WORK_DIR}/sonatinas.json")
    message(FATAL_ERROR "style-profile --out: expected ${WORK_DIR}/sonatinas.json")
endif()

# Usage errors exit 1; a run that cannot proceed exits 2.
check_case("no --name" 1 "style-profile needs --name" style-profile "${REFERENCE}")
check_case("--name alone" 1 "style-profile needs the output folder" style-profile --name reference)
# An empty name (written directly: a function drops an empty argument).
execute_process(COMMAND "${CLI}" style-profile "${REFERENCE}" --name "" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR NOT error MATCHES "style-profile needs --name")
    message(FATAL_ERROR "empty --name: expected exit 1 and 'style-profile needs --name', got ${result}: ${error}")
endif()
message(STATUS "empty --name: ok")
check_case("with a file" 1 "style-profile takes 1 input" style-profile "${REFERENCE}" --name reference "${CORPORA_DIR}/reference/Field 1.mid")
check_case("with --corpus" 1 "unknown option '--corpus'" style-profile "${REFERENCE}" --name reference --corpus "${CORPORA_DIR}/reference")
check_case("--name without a value" 1 "--name needs a value" style-profile "${REFERENCE}" --name)
check_case("not a corpus output" 2 "Error: cannot read the corpus" style-profile "${CORPORA_DIR}/reference" --name reference)
check_case("missing dir" 2 "Error: cannot read the corpus" style-profile "${WORK_DIR}/nothing" --name reference)

file(REMOVE_RECURSE "${WORK_DIR}")
