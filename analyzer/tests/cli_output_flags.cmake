# Checks which files ursatz analyze writes: one analysis document next to the input, and no report. Run with
# cmake -P and -DCLI=<ursatz> -DFIXTURE=<midi file> -DBACH_114=<Bach 114.mid> -DEXPORT_GOLDEN=<bach-114.export.txt> -DWORK_DIR=<scratch dir>.

foreach(var CLI FIXTURE BACH_114 EXPORT_GOLDEN WORK_DIR)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "${var} is not set")
    endif()
endforeach()

set(INPUT "${WORK_DIR}/piece.mid")
set(DOCUMENT "${WORK_DIR}/piece.analysis.json")

# check_case(<label> <expected exit code> <document expected> <stderr pattern, or "" for none> <analyze args>...)
function(check_case label expected_exit expect_document stderr_pattern)
    file(REMOVE_RECURSE "${WORK_DIR}")
    file(MAKE_DIRECTORY "${WORK_DIR}")
    configure_file("${FIXTURE}" "${INPUT}" COPYONLY)

    execute_process(COMMAND "${CLI}" analyze ${ARGN} RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
    if(NOT result EQUAL expected_exit)
        message(FATAL_ERROR "${label}: expected exit ${expected_exit}, got ${result}")
    endif()

    if(NOT stderr_pattern STREQUAL "" AND NOT error MATCHES "${stderr_pattern}")
        message(FATAL_ERROR "${label}: expected '${stderr_pattern}' on stderr, got: ${error}")
    endif()

    file(GLOB written "${WORK_DIR}/*.report.md" "${WORK_DIR}/*.analysis.json")
    if(expect_document)
        if(NOT written STREQUAL "${DOCUMENT}")
            message(FATAL_ERROR "${label}: expected only ${DOCUMENT} to be written, found: ${written}")
        endif()
    elseif(written)
        message(FATAL_ERROR "${label}: expected nothing to be written, found: ${written}")
    endif()
    message(STATUS "${label}: ok")
endfunction()

check_case("default" 0 TRUE "" "${INPUT}")
check_case("--json is gone" 1 FALSE "unknown option '--json'" --json "${INPUT}")
check_case("flag after path" 0 TRUE "" "${INPUT}" --meter 4/4)
check_case("--markdown is gone" 1 FALSE "unknown option '--markdown'" --markdown "${INPUT}")
check_case("unknown flag" 1 FALSE "unknown option '--bogus'" --bogus "${INPUT}")
check_case("missing path" 1 FALSE "analyze needs an input file" --meter 4/4)
check_case("two paths" 1 FALSE "analyze takes 1 input" "${INPUT}" "${INPUT}")
check_case("a flag without its value" 1 FALSE "--meter needs a value" "${INPUT}" --meter)
check_case("the output of another command" 1 FALSE "unknown option '--corpus'" --corpus "${INPUT}")

# --view text: the text export on standard output and nothing written (R-658). The export of Bach 114 is the one test_text_export_snapshots
# compares: the same piece under the same name, with the line that names the Analyzer's version left out.
function(export_text out_var)
    file(REMOVE_RECURSE "${WORK_DIR}")
    file(MAKE_DIRECTORY "${WORK_DIR}")
    configure_file("${BACH_114}" "${WORK_DIR}/Bach 114.mid" COPYONLY)
    execute_process(COMMAND "${CLI}" analyze "Bach 114.mid" --view text ${ARGN} WORKING_DIRECTORY "${WORK_DIR}"
                    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    set(export_status "${result}" PARENT_SCOPE)
    set(export_error "${error}" PARENT_SCOPE)
    string(REGEX REPLACE "\nanalyzer: [^\n]*" "" output "${output}")
    set(${out_var} "${output}" PARENT_SCOPE)
endfunction()

export_text(full)
if(NOT export_status EQUAL 0)
    message(FATAL_ERROR "--view text: exit ${export_status}: ${export_error}")
endif()
file(READ "${EXPORT_GOLDEN}" golden)
if(NOT full STREQUAL golden)
    message(FATAL_ERROR "--view text differs from ${EXPORT_GOLDEN}")
endif()
file(GLOB written "${WORK_DIR}/*.analysis.json")
if(written)
    message(FATAL_ERROR "--view text wrote ${written}")
endif()
message(STATUS "--view text: ok")

export_text(part --measures 1-4)
string(LENGTH "${full}" full_length)
string(LENGTH "${part}" part_length)
string(SUBSTRING "${full}" 0 40 head)
string(SUBSTRING "${part}" 0 40 part_head)
if(NOT export_status EQUAL 0 OR NOT part_length LESS full_length OR NOT head STREQUAL part_head)
    message(FATAL_ERROR "--measures 1-4: exit ${export_status}, ${part_length} of ${full_length} bytes, head '${part_head}'")
endif()
message(STATUS "--measures 1-4: ok")

export_text(none --measures 9000-9001)
if(NOT export_status EQUAL 1 OR NOT export_error MATCHES "no measure of 'Bach 114.mid' falls in the range given to --measures")
    message(FATAL_ERROR "--measures 9000-9001: exit ${export_status}, stderr: ${export_error}")
endif()
message(STATUS "--measures 9000-9001: no measure")

export_text(title --title "A title")
if(NOT export_status EQUAL 0 OR NOT title MATCHES "title: A title")
    message(FATAL_ERROR "--title: exit ${export_status}, no 'title: A title' in the export")
endif()
message(STATUS "--title: ok")

check_case("--measures without --view text" 1 FALSE "--measures and --title need --view text" "${INPUT}" --measures 1-4)
check_case("--title without --view text" 1 FALSE "--measures and --title need --view text" "${INPUT}" --title X)
check_case("--view of a view that does not exist" 1 FALSE "--view must be text" "${INPUT}" --view markdown)
check_case("--view text with --layers" 1 FALSE "do not go with --view text" "${INPUT}" --view text --layers "${WORK_DIR}/layers")
check_case("a measure range that is not a range" 1 FALSE "--measures must be <first>-<last>" "${INPUT}" --view text --measures 4-1)
check_case("a file that is not there" 1 FALSE "cannot read file" "${WORK_DIR}/no-such-file.mid")
check_case("layers into a place that is not a folder" 2 FALSE "Error: cannot write" "${INPUT}" --layers "${INPUT}/layers")
check_case("a model plan that cannot be written" 2 FALSE "cannot write the plan of the analysis" "${INPUT}" --model-plan "${WORK_DIR}/no-such-folder/plan.json")

file(REMOVE_RECURSE "${WORK_DIR}")
