{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mitchell-Opitz/Ursatz-Analyzer/schema/style-model.v1.schema.json",
  "title": "Ursatz-Analyzer style model",
  "description": "The counts of a corpus's harmony, rhythm, melody and form labels, as a StyleModel the Composer reads.",
  "type": "object",
  "required": ["schema", "schema_version", "style_name", "training_corpus", "model_version", "pieces", "statistics"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "ursatz-style-model" },
    "schema_version": { "const": 1 },
    "style_name": { "type": "string", "minLength": 1 },
    "training_corpus": { "type": "string", "minLength": 1, "description": "The input folder of the corpus run." },
    "model_version": { "type": "string", "minLength": 1, "description": "The analyzer version that wrote the file." },
    "pieces": { "type": "integer", "minimum": 0, "description": "How many analysis documents were counted." },
    "statistics": {
      "type": "array",
      "description": "Sorted by category, then label. total is the sum of the counts of the category.",
      "items": {
        "type": "object",
        "required": ["dimension", "category", "label", "count", "total"],
        "additionalProperties": false,
        "properties": {
          "dimension": { "enum": ["harmony", "rhythm", "melody", "form"] },
          "category": {
            "enum": [
              "chord-numeral", "chord-progression-2", "chord-progression-3", "cadence-type", "harmonic-rhythm",
              "duration", "meter", "syncopation-per-phrase",
              "melodic-interval", "contour", "phrase-range",
              "motive-degrees", "motive-intervals", "motive-rhythm", "motive-nct-figure",
              "theme-form", "phrase-length", "section-letters", "mode"
            ]
          },
          "label": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1 },
          "total": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
