# Writes the Analyzer's producer key header (R-554). Script mode: cmake -DROOT=<repository root> -DLIST=<file> -DOUT=<header> -P.
# LIST holds one path per line, relative to ROOT: the sources that produce an analysis. The key is the first 16 hex
# digits of the SHA-256 of the text "<path> <file SHA-256>" per line, so it changes when any listed file changes and
# not otherwise. OUT is written only when its content differs, so an unchanged key rebuilds nothing.

file(READ "${LIST}" listed)
string(REGEX REPLACE "\n$" "" listed "${listed}")
string(REPLACE "\n" ";" paths "${listed}")

set(text "")
foreach(path IN LISTS paths)
    file(SHA256 "${ROOT}/${path}" digest)
    string(APPEND text "${path} ${digest}\n")
endforeach()
string(SHA256 all "${text}")
string(SUBSTRING "${all}" 0 16 key)

set(content "/* Generated by analyzer/cmake/ProducerKey.cmake: do not edit. */\n#define URSATZ_ANALYZER_PRODUCER_KEY \"${key}\"\n")
set(current "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" current)
endif()
if(NOT current STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
